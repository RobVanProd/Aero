fn dot_with_bias(left: [int; 8], right: [int; 8], bias: int) -> int {
    let mut index: int = 0;
    let mut accumulator: int = bias;
    while index < 8 {
        accumulator = accumulator + left[index] * right[index];
        index = index + 1;
    }
    return accumulator;
}

fn offset_first_lane(values: [int; 8]) -> [i32; 8] {
    return [values[0] + 1, values[1], values[2], values[3], values[4], values[5], values[6], values[7]];
}

fn forward_array(values: [i32; 8]) -> [int; 8] {
    return values;
}

fn main() -> int {
    let activations: [int; 8] = [127, 1073741824, -128, 64, -64, 7, -3, 11];
    let weights: [int; 8] = [8, 2, -7, 6, -5, 4, -3, 2];
    let transformed = offset_first_lane(activations);
    let result: int = dot_with_bias(forward_array(transformed), weights, 2147483000);
    if activations[0] == 127 && transformed[0] == 128 && result == 2035 {
        return 91;
    }
    return 1;
}
