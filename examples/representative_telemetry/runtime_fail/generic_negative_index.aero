struct Window<T> { values: [T; 2] }

fn window_get<T>(window: Window<T>, index: int) -> T {
    window.values[index]
}

fn main() -> int {
    let values: Window<int> = Window { values: [10, 20] };
    let zero = 0;
    let index = zero - 1;
    let selected = window_get(values, index);
    println!("unreachable generic negative index: {}", selected);
    0
}
