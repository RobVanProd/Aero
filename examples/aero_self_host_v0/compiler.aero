                        status = 8;
                        error_offset = token_start;
                        error_line = token_line;
                        error_column = token_column;
                        lexing = 0;
                    } else {
                        token_count = token_count + 1;
                        offset = token_end;
                        column = column + token_length;
                    }
                }
            }
        }
    }

    if status == 0 {
        kind = 0;
        token_start = source_length;
        token_length = 0;
        token_line = line;
        token_column = column;
        name_id = 0;
        append_failed = 0;
        append_field = 0;
        while append_field < 6 && append_failed == 0 {
            word = kind;
            if append_field == 1 {
                word = token_start;
            } else if append_field == 2 {
                word = token_length;
            } else if append_field == 3 {
                word = token_line;
            } else if append_field == 4 {
                word = token_column;
            } else if append_field == 5 {
                word = name_id;
            }
            push_result = result_value(bytes_push(&mut tokens, word_byte_0(word)));
            if push_result < 0 {
                append_failed = 1;
            }
            if append_failed == 0 {
                push_result = result_value(bytes_push(&mut tokens, word_byte_1(word)));
                if push_result < 0 {
                    append_failed = 1;
                }
            }
            if append_failed == 0 {
                push_result = result_value(bytes_push(&mut tokens, word_byte_2(word)));
                if push_result < 0 {
                    append_failed = 1;
                }
            }
            if append_failed == 0 {
                push_result = result_value(bytes_push(&mut tokens, word_byte_3(word)));
                if push_result < 0 {
                    append_failed = 1;
                }
            }
            append_field = append_field + 1;
        }
        if append_failed == 1 {
            status = 8;
            error_offset = source_length;
            error_line = line;
            error_column = column;
        } else {
            token_count = token_count + 1;
            lex_complete = 1;
        }
    }

    // CAP-043 preserves CAP-042's one flat parser driver. Each D1 append
    // decision first emits its parallel origin and then the frozen node.
    let mut node_count: int = 0;
    let mut origin_count: int = 0;
    let mut root: int = 0;
    let mut node_id: int = 0;
    let mut parse_index: int = 0;
    let mut parser_running: int = 0;
    let mut parser_state: int = 0;
    let mut parser_cycle_state: int = 0;
    if status == 0 {
        parser_running = 1;
        parser_state = 1;
    }

    let mut current_kind: int = 0;
    let mut current_start: int = 0;
    let mut current_length: int = 0;
    let mut current_line: int = 0;
    let mut current_column: int = 0;
    let mut current_name_id: int = 0;
    let mut expected_kind: int = 0;
    let mut skeleton_step: int = 0;
    let mut function_start: int = 0;
    let mut function_line: int = 0;
    let mut function_column: int = 0;
    let mut function_name_id: int = 0;
    let mut return_start: int = 0;
    let mut return_line: int = 0;
    let mut return_column: int = 0;
    let mut closing_step: int = 0;
    let mut closing_cycle_step: int = 0;
    let mut module_next_item: int = 0;
    let mut item_previous: int = 0;
    let mut int_matches: int = 0;
    let mut parameter_count: int = 0;
    let mut param_mode: int = 0;
    let mut param_cycle_mode: int = 0;
    let mut param_alternate: int = 0;
    let mut param_hold: int = 0;
    let mut param_store: int = 0;
    let mut param_name_id: int = 0;
    let mut param_type_code: int = 0;
    let mut param_is_int: int = 0;
    let mut param_is_result: int = 0;
    let mut param_failed: int = 0;
    let mut param_push: int = 0;
    let mut param_b0: int = 0;
    let mut param_b1: int = 0;
    let mut param_b2: int = 0;
    let mut param_b3: int = 0;
    let mut param_b4: int = 0;
    let mut param_b5: int = 0;
    let mut match_active: int = 0;
    let mut match_step: int = 0;
    let mut match_cycle_step: int = 0;
    let mut match_expected: int = 0;
    let mut match_is_match: int = 0;
    let mut match_b0: int = 0;
    let mut match_b1: int = 0;
    let mut match_b2: int = 0;
    let mut match_b3: int = 0;
    let mut match_b4: int = 0;
    let mut statement_mode: int = 0;
    let mut stmt_step: int = 0;
    let mut stmt_cycle_step: int = 0;
    let mut stmt_expected: int = 0;
    let mut stmt_alternate: int = 0;
    let mut stmt_is_int: int = 0;
    let mut stmt_is_buffer: int = 0;
    let mut stmt_is_result: int = 0;
    let mut stmt_b0: int = 0;
    let mut stmt_b1: int = 0;
    let mut stmt_b2: int = 0;
    let mut stmt_b3: int = 0;
    let mut stmt_b4: int = 0;
    let mut stmt_b5: int = 0;
    let mut stmt_b6: int = 0;
    let mut stmt_b7: int = 0;
    let mut stmt_b8: int = 0;
    let mut stmt_b9: int = 0;
    let mut body_root: int = 0;
    let mut block_state: int = 0;
    let mut block_top: int = 0;
    let mut block_depth: int = 0;
    let mut block_records: int = 0;
    let mut block_else: int = 0;
    let mut block_kind_push: int = 0;
    let mut block_kind_popped: int = 0;
    let mut block_state_saved: int = 0;
    let mut block_previous: int = 0;
    let mut stmt_is_else: int = 0;
    let mut stmt_close_expected: int = 0;
    let mut stmt_terminator: int = 0;
    let mut expression_dispatch: int = 0;
    let mut held_active: int = 0;
    let mut held_name: int = 0;
    let mut held_start: int = 0;
    let mut held_line: int = 0;
    let mut held_column: int = 0;
    let mut ref_pending: int = 0;
    let mut ref_marker: int = 0;
    let mut ref_advance: int = 0;
    let mut ref_start: int = 0;
    let mut ref_line: int = 0;
    let mut ref_column: int = 0;
    let mut arg_leading: int = 0;
    let mut arg_open: int = 0;
    let mut call_top: int = 0;
    let mut call_base: int = 0;
    let mut call_records: int = 0;
    let mut call_callee: int = 0;
    let mut call_chain: int = 0;
    let mut call_argument: int = 0;

    let mut value_top: int = 0;
    let mut value_depth: int = 0;
    let mut value_records: int = 0;
    let mut operator_top: int = 0;
    let mut operator_depth: int = 0;
    let mut operator_records: int = 0;
    let mut paren_depth: int = 0;
    let mut expecting_operand: int = 1;
    let mut expression_root: int = 0;
    let mut literal_value: int = 0;
    let mut decimal_index: int = 0;
    let mut decimal_digit: int = 0;
    let mut current_precedence: int = 0;
    let mut reduction_mode: int = 0;
    let mut top_kind: int = 0;
    let mut top_start: int = 0;
    let mut top_line: int = 0;
    let mut top_column: int = 0;
    let mut top_previous: int = 0;
    let mut top_precedence: int = 0;
    let mut right_id: int = 0;
    let mut left_id: int = 0;
    let mut value_previous: int = 0;
    let mut reduced_kind: int = 0;
    let mut reduction_actual: int = 0;

    let mut parser_token_after: int = 0;
    let mut parser_token_field: int = 0;
    let mut parser_token_byte: int = 0;
    let mut parser_token_word: int = 0;
    let mut parser_read_offset: int = 0;
    let mut parser_read_byte_value: int = 0;
    let mut parser_step_byte: int = 0;

    let mut parser_record_target: int = 0;
    let mut parser_record_width: int = 0;
    let mut parser_record_index: int = 0;
    let mut parser_record_field: int = 0;
    let mut parser_record_byte: int = 0;
    let mut parser_record_word: int = 0;
    let mut parser_record_after: int = 0;
    let mut parser_record_0: int = 0;
    let mut parser_record_1: int = 0;
    let mut parser_record_2: int = 0;
    let mut parser_record_3: int = 0;
    let mut parser_record_4: int = 0;

    let mut parser_append_target: int = 0;
    let mut parser_append_width: int = 0;
    let mut parser_append_field: int = 0;
    let mut parser_append_byte: int = 0;
    let mut parser_append_word: int = 0;
    let mut parser_append_after: int = 0;
    let mut parser_append_0: int = 0;
    let mut parser_append_1: int = 0;
    let mut parser_append_2: int = 0;
    let mut parser_append_3: int = 0;
    let mut parser_append_4: int = 0;
    let mut parser_append_offset: int = 0;
    let mut parser_append_line: int = 0;
    let mut parser_append_column: int = 0;
    let mut pending_node_kind: int = 0;
    let mut pending_node_payload: int = 0;
    let mut pending_node_left: int = 0;
    let mut pending_node_right: int = 0;
    let mut pending_node_after: int = 0;
    let mut pending_node_offset: int = 0;
    let mut pending_node_line: int = 0;
    let mut pending_node_column: int = 0;

    while parser_running == 1 {
        parser_cycle_state = parser_state;

        // Request one complete located token record.
        if parser_cycle_state == 1 {
            parser_token_after = 2;
            parser_token_field = 0;
            parser_token_byte = 0;
            parser_token_word = 0;
            parser_state = 30;
        }
        if parser_cycle_state == 3 {
            parser_token_after = 4;
            parser_token_field = 0;
            parser_token_byte = 0;
            parser_token_word = 0;
            parser_state = 30;
        }
        if parser_cycle_state == 20 {
            parser_token_after = 21;
            parser_token_field = 0;
            parser_token_byte = 0;
            parser_token_word = 0;
            parser_state = 30;
        }
        // CAP-051 requests the leading token of the return expression, and then
        // one token per step of the admitted match construct.
        if parser_cycle_state == 40 {
            parser_token_after = 41;
            parser_token_field = 0;
            parser_token_byte = 0;
            parser_token_word = 0;
            parser_state = 30;
        }
        if parser_cycle_state == 42 {
            parser_token_after = 43;
            parser_token_field = 0;
            parser_token_byte = 0;
            parser_token_word = 0;
            parser_state = 30;
        }
        // CAP-052 requests the leading token of each statement, one token per
        // step of a binding or an assignment, and the statement's own ';'.
        if parser_cycle_state == 44 {
            parser_token_after = 45;
            parser_token_field = 0;
            parser_token_byte = 0;
            parser_token_word = 0;
            parser_state = 30;
        }
        if parser_cycle_state == 46 {
            parser_token_after = 47;
            parser_token_field = 0;
            parser_token_byte = 0;
            parser_token_word = 0;
            parser_state = 30;
        }
        if parser_cycle_state == 48 {
            parser_token_after = 49;
            parser_token_field = 0;
            parser_token_byte = 0;
            parser_token_word = 0;
            parser_state = 30;
        }
        // CAP-053 requests the one token after an 'else'.
        if parser_cycle_state == 50 {
            parser_token_after = 51;
            parser_token_field = 0;
            parser_token_byte = 0;
            parser_token_word = 0;
            parser_state = 30;
        }

        // Decode one token byte per iteration.
        if parser_cycle_state == 30 {
            parser_step_byte = parser_token_byte;
            if parse_index < 0 || parse_index >= token_count {
                status = 16;
                parser_running = 0;
            }
            if parser_running == 1 {
                parser_read_offset = parse_index * 24;
                parser_read_offset = parser_read_offset + parser_token_field * 4;
                parser_read_offset = parser_read_offset + parser_token_byte;
                parser_read_byte_value = result_value(bytes_get(&tokens,
                    parser_read_offset));
                if parser_read_byte_value < 0 {
                    status = 16;
                    parser_running = 0;
                }
            }
            if parser_running == 1 && parser_step_byte == 0 {
                parser_token_word = parser_read_byte_value;
            }
            if parser_running == 1 && parser_step_byte == 1 {
                parser_token_word = parser_token_word + parser_read_byte_value * 256;
            }
            if parser_running == 1 && parser_step_byte == 2 {
                parser_token_word = parser_token_word + parser_read_byte_value * 65536;
            }
            if parser_running == 1 && parser_step_byte == 3 {
                if parser_read_byte_value > 127 {
                    status = 16;
                    parser_running = 0;
                } else {
                    parser_token_word = parser_token_word
                        + parser_read_byte_value * 16777216;
                }
            }
            if parser_running == 1 && parser_step_byte < 3 {
                parser_token_byte = parser_step_byte + 1;
            }
            if parser_running == 1 && parser_step_byte == 3 {
                if parser_token_field == 0 {
                    current_kind = parser_token_word;
                }
                if parser_token_field == 1 {
                    current_start = parser_token_word;
                }
                if parser_token_field == 2 {
                    current_length = parser_token_word;
                }
                if parser_token_field == 3 {
                    current_line = parser_token_word;
                }
                if parser_token_field == 4 {
                    current_column = parser_token_word;
                }
                if parser_token_field == 5 {
                    current_name_id = parser_token_word;
                }
                parser_token_field = parser_token_field + 1;
                parser_token_byte = 0;
                parser_token_word = 0;
                if parser_token_field == 6 {
                    parser_state = parser_token_after;
                }
            }
        }

        // Fixed function/return skeleton.
        if parser_cycle_state == 2 {
            expected_kind = 3;
            if skeleton_step == 1 || skeleton_step == 5 {
                expected_kind = 1;
            }
            if skeleton_step == 2 {
                expected_kind = 10;
            }
            if skeleton_step == 3 {
                expected_kind = 11;
            }
            if skeleton_step == 4 {
                expected_kind = 35;
            }
            if skeleton_step == 6 {
                expected_kind = 12;
            }
            // CAP-052 dissolves the skeleton's fixed `return` step into the
            // statement loop, so the skeleton ends at the body's '{'.
            // CAP-050 signature grammar. Between the '(' at step 2 and the '->'
            // at step 4 the parameter sub-machine owns step 3. Its mode is
            // latched once per token, exactly as parser_state is, so the flat
            // per-mode branches cannot cascade within one iteration.
            param_cycle_mode = param_mode;
            param_alternate = 0;
            param_hold = 0;
            param_store = 0;
            if skeleton_step == 3 {
                expected_kind = 1;
                if param_cycle_mode == 0 {
                    param_alternate = 11;
                }
                if param_cycle_mode == 1 {
                    expected_kind = 17;
                }
                if param_cycle_mode == 3 {
                    expected_kind = 29;
                }
                if param_cycle_mode == 5 {
                    expected_kind = 16;
                }
                if param_cycle_mode == 7 {
                    expected_kind = 31;
                }
                if param_cycle_mode == 8 {
                    expected_kind = 11;
                    param_alternate = 16;
                }
                param_hold = 1;
            }
            if current_kind < 0 || current_start < 0 || current_length < 0 {
                status = 16;
                parser_running = 0;
            }
            if parser_running == 1 && (current_line <= 0 || current_column <= 0
                || current_name_id < 0) {
                status = 16;
                parser_running = 0;
            }
            if parser_running == 1 && current_kind != expected_kind
                && (param_alternate == 0 || current_kind != param_alternate) {
                status = 10;
                error_offset = current_start;
                error_line = current_line;
                error_column = current_column;
                diagnostic_code = expected_kind;
                diagnostic_actual = current_kind;
                parser_running = 0;
            }
            if parser_running == 1 && skeleton_step == 3 {
                if param_cycle_mode == 0 && current_kind == 11 {
                    param_hold = 0;
                    param_mode = 0;
                }
                if param_cycle_mode == 8 && current_kind == 11 {
                    param_hold = 0;
                    param_mode = 0;
                }
                if param_cycle_mode == 8 && current_kind == 16 {
                    param_mode = 9;
                }
                if (param_cycle_mode == 0 && current_kind == 1)
