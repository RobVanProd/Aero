                emitted_fragment = emitted_opcode + 2;
            } else {
                emitted_fragment = 10;
            }
            emitted_fragment_index = 0;
            emitted_fragment_length = emitter_fixed_length(emitted_fragment);
            while emitted_status == 0
                && emitted_fragment_index < emitted_fragment_length {
