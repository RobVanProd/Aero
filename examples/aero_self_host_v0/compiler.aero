    while validate_node < node_count {
        validate_node_field = 0;
        while validate_node_field < 4 {
            word_offset = validate_node * 16 + validate_node_field * 4;
            byte_0 = result_value(bytes_get(&nodes, word_offset));
            byte_1 = result_value(bytes_get(&nodes, word_offset + 1));
            byte_2 = result_value(bytes_get(&nodes, word_offset + 2));
            byte_3 = result_value(bytes_get(&nodes, word_offset + 3));
            if byte_0 < 0 || byte_1 < 0 || byte_2 < 0 || byte_3 < 0 || byte_3 > 127 {
                return 77;
            }
            word = byte_0 + byte_1 * 256 + byte_2 * 65536 + byte_3 * 16777216;
            checksum = checksum_step(checksum, word);
            if validate_node_field == 0 {
                validate_node_kind = word;
            } else if validate_node_field == 1 {
                validate_payload = word;
            } else if validate_node_field == 2 {
                validate_left = word;
            } else {
                validate_right = word;
            }
            validate_node_field = validate_node_field + 1;
        }
        node_id = validate_node + 1;
        if validate_node_kind <= 0 || validate_node_kind > 23 {
            return 78;
        }
        if validate_node_kind == 1 {
            if validate_left != 0 || validate_right != 0 {
                return 78;
            }
        } else if validate_node_kind == 2 {
            if validate_payload <= 0 || validate_payload > name_count
                || validate_left != 0 || validate_right != 0 {
                return 78;
            }
        } else if validate_node_kind == 3 || validate_node_kind == 4
            || validate_node_kind == 18 || validate_node_kind == 22
            || validate_node_kind == 23 {
            if validate_payload != 0 || validate_left <= 0
                || validate_left >= node_id || validate_right != 0 {
                return 78;
            }
        } else if validate_node_kind >= 5 && validate_node_kind <= 17 {
            if validate_payload != 0 || validate_left <= 0 || validate_right <= 0
                || validate_left >= node_id || validate_right >= node_id {
                return 78;
            }
        } else if validate_node_kind == 20 {
            if validate_payload <= 0 || validate_payload > name_count
                || validate_left < 0 || validate_left >= node_id
                || validate_right != 0 {
                return 78;
            }
        } else if validate_node_kind == 21 {
            if validate_payload != 0 || validate_left <= 0
                || validate_left >= node_id || validate_right < 0
                || validate_right >= node_id {
                return 78;
            }
        } else if validate_node_kind == 19 {
            if validate_payload <= 0 || validate_payload > name_count
                || validate_left <= 0 || validate_left >= node_id
                || validate_right < 0 || validate_right >= node_id {
                return 78;
            }
        } else {
            return 78;
        }
        validate_node = validate_node + 1;
    }
    if status == 0 {
        word = -1;
        if root > 0 {
            word_offset = (root - 1) * 16;
            word = result_value(bytes_get(&nodes, word_offset))
                + result_value(bytes_get(&nodes, word_offset + 1)) * 256
                + result_value(bytes_get(&nodes, word_offset + 2)) * 65536
                + result_value(bytes_get(&nodes, word_offset + 3)) * 16777216;
        }
        if root <= 0 || root != node_count
            || word != 19 {
            return 79;
        }
    } else if root != 0 {
        return 79;
    }
    checksum = checksum_step(checksum, 993);

    checksum = checksum_step(checksum, status);
    checksum = checksum_step(checksum, error_offset + 1);
    checksum = checksum_step(checksum, error_line);
    checksum = checksum_step(checksum, error_column);
    checksum = checksum_step(checksum, diagnostic_code);
    checksum = checksum_step(checksum, diagnostic_actual);
    checksum = checksum_step(checksum, name_count);
    checksum = checksum_step(checksum, token_count);
    checksum = checksum_step(checksum, node_count);
    checksum = checksum_step(checksum, root);

    checksum = checksum_step(checksum, 989);
    let mut validate_parameter: int = 0;
    let mut validate_param_field: int = 0;
    let mut validate_param_name: int = 0;
    let mut validate_param_type: int = 0;
    if bytes_len(&parameters) != parameter_count * 8 {
        return 69;
    }
    while validate_parameter < parameter_count {
        validate_param_field = 0;
        while validate_param_field < 2 {
            word_offset = validate_parameter * 8 + validate_param_field * 4;
            byte_0 = result_value(bytes_get(&parameters, word_offset));
            byte_1 = result_value(bytes_get(&parameters, word_offset + 1));
            byte_2 = result_value(bytes_get(&parameters, word_offset + 2));
            byte_3 = result_value(bytes_get(&parameters, word_offset + 3));
            if byte_0 < 0 || byte_1 < 0 || byte_2 < 0 || byte_3 < 0 || byte_3 > 127 {
                return 69;
            }
            word = byte_0 + byte_1 * 256 + byte_2 * 65536 + byte_3 * 16777216;
            checksum = checksum_step(checksum, word);
            if validate_param_field == 0 {
                validate_param_name = word;
            } else {
                validate_param_type = word;
            }
            validate_param_field = validate_param_field + 1;
        }
        if validate_param_name <= 0 || validate_param_name > name_count
            || validate_param_type < 1 || validate_param_type > 2 {
            return 69;
        }
        validate_parameter = validate_parameter + 1;
    }
    checksum = checksum_step(checksum, parameter_count);

    if status != expected_status || error_offset != expected_offset
        || error_line != expected_line || error_column != expected_column
        || diagnostic_code != expected_code || diagnostic_actual != expected_actual
        || name_count != expected_names || token_count != expected_tokens
        || node_count != expected_nodes || root != expected_root
        || parameter_count != expected_parameters
        || checksum != expected_checksum {
        return 80;
    }

    // Validate the parallel origin sidecar against source, tokens, and nodes.
    let mut origin_index: int = 0;
    let mut origin_field: int = 0;
    let mut origin_word: int = 0;
    let mut origin_node_id: int = 0;
    let mut origin_offset: int = 0;
    let mut origin_line: int = 0;
    let mut origin_column: int = 0;
    let mut origin_token_kind: int = 0;
    let mut origin_node_kind: int = 0;
    let mut origin_expected_kind: int = 0;
    let mut origin_token_index: int = 0;
    let mut origin_token_field: int = 0;
    let mut origin_token_word: int = 0;
    let mut origin_token_record_kind: int = 0;
    let mut origin_token_start: int = 0;
    let mut origin_token_line: int = 0;
    let mut origin_token_column: int = 0;
    let mut origin_token_found: int = 0;
    if status == 0 && semantic_status == 0 {
        if bytes_len(&origins) != origin_count * 20 || origin_count != node_count {
            semantic_status = 27;
            semantic_node = origin_count + 1;
            semantic_code = 1;
        }
    }
    while status == 0 && semantic_status == 0 && origin_index < origin_count {
        origin_field = 0;
        origin_node_id = 0;
        origin_offset = 0;
        origin_line = 0;
        origin_column = 0;
        origin_token_kind = 0;
        while semantic_status == 0 && origin_field < 5 {
            word_offset = origin_index * 20 + origin_field * 4;
            byte_0 = result_value(bytes_get(&origins, word_offset));
            byte_1 = result_value(bytes_get(&origins, word_offset + 1));
            byte_2 = result_value(bytes_get(&origins, word_offset + 2));
            byte_3 = result_value(bytes_get(&origins, word_offset + 3));
            if byte_0 < 0 || byte_1 < 0 || byte_2 < 0 || byte_3 < 0 || byte_3 > 127 {
                semantic_status = 27;
                semantic_node = origin_index + 1;
                semantic_code = 1;
            } else {
                origin_word = byte_0 + byte_1 * 256 + byte_2 * 65536
                    + byte_3 * 16777216;
                if origin_field == 0 {
                    origin_node_id = origin_word;
                } else if origin_field == 1 {
                    origin_offset = origin_word;
                } else if origin_field == 2 {
                    origin_line = origin_word;
                } else if origin_field == 3 {
                    origin_column = origin_word;
                } else {
                    origin_token_kind = origin_word;
                }
                origin_field = origin_field + 1;
            }
        }
        if semantic_status == 0 {
            semantic_node = origin_node_id;
            semantic_offset = origin_offset;
            semantic_line = origin_line;
            semantic_column = origin_column;
            semantic_code = 1;
            if origin_node_id != origin_index + 1 || origin_offset < 0
                || origin_offset > source_length || origin_line <= 0
                || origin_column <= 0 || origin_token_kind <= 0
                || origin_token_kind > 37 {
                semantic_status = 27;
            }
        }
        if semantic_status == 0 {
            location_index = 0;
            location_line = 1;
            location_column = 1;
            while semantic_status == 0 && location_index < origin_offset {
                byte = result_value(bytes_get(&source, location_index));
                if byte < 0 {
                    semantic_status = 27;
                } else if byte == 10 {
                    location_line = location_line + 1;
                    location_column = 1;
                } else {
                    location_column = location_column + 1;
                }
                location_index = location_index + 1;
            }
            if semantic_status == 0 && (location_line != origin_line
                || location_column != origin_column) {
                semantic_status = 27;
            }
        }
        if semantic_status == 0 {
            word_offset = origin_index * 16;
            byte_0 = result_value(bytes_get(&nodes, word_offset));
            byte_1 = result_value(bytes_get(&nodes, word_offset + 1));
            byte_2 = result_value(bytes_get(&nodes, word_offset + 2));
            byte_3 = result_value(bytes_get(&nodes, word_offset + 3));
            if byte_0 < 0 || byte_1 < 0 || byte_2 < 0 || byte_3 < 0 || byte_3 > 127 {
                semantic_status = 27;
            } else {
                origin_node_kind = byte_0 + byte_1 * 256 + byte_2 * 65536
                    + byte_3 * 16777216;
                origin_expected_kind = 0;
                if origin_node_kind == 1 {
                    origin_expected_kind = 2;
                }
                if origin_node_kind == 2 {
                    origin_expected_kind = 1;
                }
                if origin_node_kind == 3 {
                    origin_expected_kind = 21;
                }
                if origin_node_kind == 4 {
                    origin_expected_kind = 27;
                }
                if origin_node_kind == 5 {
                    origin_expected_kind = 22;
                }
                if origin_node_kind == 6 {
                    origin_expected_kind = 23;
                }
                if origin_node_kind == 7 {
                    origin_expected_kind = 24;
                }
                if origin_node_kind == 8 {
                    origin_expected_kind = 20;
                }
                if origin_node_kind == 9 {
                    origin_expected_kind = 21;
                }
                if origin_node_kind == 10 {
                    origin_expected_kind = 29;
                }
                if origin_node_kind == 11 {
                    origin_expected_kind = 30;
                }
                if origin_node_kind == 12 {
                    origin_expected_kind = 31;
                }
                if origin_node_kind == 13 {
                    origin_expected_kind = 32;
                }
                if origin_node_kind == 14 {
                    origin_expected_kind = 26;
                }
                if origin_node_kind == 15 {
                    origin_expected_kind = 28;
                }
                if origin_node_kind == 16 {
                    origin_expected_kind = 33;
                }
                if origin_node_kind == 17 {
                    origin_expected_kind = 34;
                }
                if origin_node_kind == 18 {
                    origin_expected_kind = 6;
                }
                if origin_node_kind == 19 {
                    origin_expected_kind = 3;
                }
                if origin_node_kind == 20 {
                    origin_expected_kind = 10;
                }
                if origin_node_kind == 21 {
                    origin_expected_kind = 11;
                }
                if origin_node_kind == 22 {
                    origin_expected_kind = 37;
                }
                if origin_node_kind == 23 {
                    origin_expected_kind = 37;
                }
                if origin_expected_kind == 0 || origin_token_kind != origin_expected_kind {
                    semantic_status = 27;
                }
            }
        }
        if semantic_status == 0 {
            origin_token_index = 0;
            origin_token_found = 0;
            while origin_token_index < token_count && origin_token_found == 0 {
                origin_token_field = 0;
                origin_token_record_kind = 0;
                origin_token_start = 0;
                origin_token_line = 0;
                origin_token_column = 0;
                while semantic_status == 0 && origin_token_field < 5 {
                    word_offset = origin_token_index * 24 + origin_token_field * 4;
                    byte_0 = result_value(bytes_get(&tokens, word_offset));
                    byte_1 = result_value(bytes_get(&tokens, word_offset + 1));
                    byte_2 = result_value(bytes_get(&tokens, word_offset + 2));
                    byte_3 = result_value(bytes_get(&tokens, word_offset + 3));
                    if byte_0 < 0 || byte_1 < 0 || byte_2 < 0 || byte_3 < 0
                        || byte_3 > 127 {
                        semantic_status = 27;
                    } else {
                        origin_token_word = byte_0 + byte_1 * 256 + byte_2 * 65536
                            + byte_3 * 16777216;
                        if origin_token_field == 0 {
                            origin_token_record_kind = origin_token_word;
                        } else if origin_token_field == 1 {
                            origin_token_start = origin_token_word;
                        } else if origin_token_field == 3 {
                            origin_token_line = origin_token_word;
                        } else if origin_token_field == 4 {
                            origin_token_column = origin_token_word;
                        }
                        origin_token_field = origin_token_field + 1;
                    }
                }
                if semantic_status == 0 && origin_token_record_kind == origin_token_kind
                    && origin_token_start == origin_offset
                    && origin_token_line == origin_line
                    && origin_token_column == origin_column {
                    origin_token_found = 1;
                }
                origin_token_index = origin_token_index + 1;
            }
            if semantic_status == 0 && origin_token_found == 0 {
                semantic_status = 27;
            }
        }
        origin_index = origin_index + 1;
    }

    // Emit one bounded function symbol per module item, in source order.
    //
    // CAP-058/H1M-2 Decision 4. The item chain is walked from `root` for its
    // count - CAP-056 gave a kind-19 node's `right` the previous item's node
    // id - and the symbols are appended by a separate ascending scan, which is
    // source order and the order the fact loop meets the items in. The two
    // walks are independent, so `symbol_count != semantic_item_count` below
    // is a real
    // check rather than a tautology. For one item both reduce to the accepted
    // path term by term: the single item is first and last, and its `right`
    // is zero.
    let mut symbol_count: int = 0;
    let mut fact_count: int = 0;
    let mut semantic_append_field: int = 0;
    let mut semantic_append_byte: int = 0;
    let mut semantic_append_word: int = 0;
    let mut semantic_append_value: int = 0;
    let mut function_payload: int = 0;
    let mut semantic_item_count: int = 0;
    let mut semantic_item_link: int = 0;
    let mut semantic_item_previous: int = 0;
    let mut semantic_item_kind: int = 0;
    let mut semantic_item_node: int = 0;
    if status == 0 && semantic_status == 0 {
        semantic_item_link = root;
        while semantic_status == 0 && semantic_item_link > 0 {
            word_offset = (semantic_item_link - 1) * 16;
            byte_0 = result_value(bytes_get(&nodes, word_offset));
            byte_1 = result_value(bytes_get(&nodes, word_offset + 1));
            byte_2 = result_value(bytes_get(&nodes, word_offset + 2));
            byte_3 = result_value(bytes_get(&nodes, word_offset + 3));
            semantic_item_kind = 0;
            semantic_item_previous = 0;
            if byte_0 < 0 || byte_1 < 0 || byte_2 < 0 || byte_3 < 0 || byte_3 > 127 {
                semantic_status = 27;
                semantic_node = semantic_item_link;
                semantic_code = 3;
            } else {
                semantic_item_kind = byte_0 + byte_1 * 256 + byte_2 * 65536
                    + byte_3 * 16777216;
                word_offset = (semantic_item_link - 1) * 16 + 12;
                byte_0 = result_value(bytes_get(&nodes, word_offset));
                byte_1 = result_value(bytes_get(&nodes, word_offset + 1));
                byte_2 = result_value(bytes_get(&nodes, word_offset + 2));
                byte_3 = result_value(bytes_get(&nodes, word_offset + 3));
                if byte_0 < 0 || byte_1 < 0 || byte_2 < 0 || byte_3 < 0
                    || byte_3 > 127 {
                    semantic_status = 27;
                    semantic_node = semantic_item_link;
                    semantic_code = 3;
                } else {
                    semantic_item_previous = byte_0 + byte_1 * 256 + byte_2 * 65536
                        + byte_3 * 16777216;
                }
            }
            if semantic_status == 0 && (semantic_item_kind != 19 || semantic_item_previous < 0
                || semantic_item_previous >= semantic_item_link) {
                semantic_status = 27;
                semantic_node = semantic_item_link;
                semantic_code = 3;
            }
            if semantic_status == 0 {
                semantic_item_count = semantic_item_count + 1;
                semantic_item_link = semantic_item_previous;
            }
        }
    }
    if status == 0 && semantic_status == 0 {
        semantic_item_node = 1;
        while semantic_status == 0 && semantic_item_node <= node_count {
            word_offset = (semantic_item_node - 1) * 16;
            byte_0 = result_value(bytes_get(&nodes, word_offset));
            byte_1 = result_value(bytes_get(&nodes, word_offset + 1));
            byte_2 = result_value(bytes_get(&nodes, word_offset + 2));
            byte_3 = result_value(bytes_get(&nodes, word_offset + 3));
            semantic_item_kind = 0;
            if byte_0 < 0 || byte_1 < 0 || byte_2 < 0 || byte_3 < 0 || byte_3 > 127 {
                semantic_status = 27;
                semantic_node = semantic_item_node;
                semantic_code = 3;
            } else {
                semantic_item_kind = byte_0 + byte_1 * 256 + byte_2 * 65536
                    + byte_3 * 16777216;
            }
            if semantic_status == 0 && semantic_item_kind == 19 {
                word_offset = (semantic_item_node - 1) * 16 + 4;
                byte_0 = result_value(bytes_get(&nodes, word_offset));
                byte_1 = result_value(bytes_get(&nodes, word_offset + 1));
                byte_2 = result_value(bytes_get(&nodes, word_offset + 2));
                byte_3 = result_value(bytes_get(&nodes, word_offset + 3));
                if byte_0 < 0 || byte_1 < 0 || byte_2 < 0 || byte_3 < 0
                    || byte_3 > 127 {
                    semantic_status = 27;
                    semantic_node = semantic_item_node;
                    semantic_code = 3;
                } else {
                    function_payload = byte_0 + byte_1 * 256 + byte_2 * 65536
                        + byte_3 * 16777216;
                }
                semantic_append_field = 0;
                while semantic_status == 0 && semantic_append_field < 4 {
                    semantic_append_word = 1;
                    if semantic_append_field == 1 {
                        semantic_append_word = function_payload;
                    } else if semantic_append_field == 2 {
                        semantic_append_word = semantic_item_node;
                    } else if semantic_append_field == 3 {
                        semantic_append_word = 1;
                    }
                    semantic_append_byte = 0;
                    while semantic_status == 0 && semantic_append_byte < 4 {
                        semantic_append_value = word_byte_0(semantic_append_word);
                        if semantic_append_byte == 1 {
                            semantic_append_value = word_byte_1(semantic_append_word);
                        } else if semantic_append_byte == 2 {
                            semantic_append_value = word_byte_2(semantic_append_word);
                        } else if semantic_append_byte == 3 {
                            semantic_append_value = word_byte_3(semantic_append_word);
                        }
                        push_result = result_value(bytes_push(&mut symbols, semantic_append_value));
                        if push_result < 0 {
                            semantic_status = 26;
                            semantic_node = semantic_item_node;
                            semantic_code = 2;
                        }
                        semantic_append_byte = semantic_append_byte + 1;
                    }
                    semantic_append_field = semantic_append_field + 1;
                }
                if semantic_status == 0 {
                    symbol_count = symbol_count + 1;
                }
            }
            semantic_item_node = semantic_item_node + 1;
        }
    }
    // A per-item failure is located at that item own origin record. The
    // function_start / function_line / function_column registers hold the
    // *last* signature location after a completed multi-item parse, which is
    // right for a whole-module check and wrong for one item.
    if status == 0 && semantic_node > 0 && semantic_offset < 0
        && (semantic_status == 26 || semantic_status == 27) {
        word_offset = (semantic_node - 1) * 20 + 4;
        semantic_offset = result_value(bytes_get(&origins, word_offset))
            + result_value(bytes_get(&origins, word_offset + 1)) * 256
            + result_value(bytes_get(&origins, word_offset + 2)) * 65536
            + result_value(bytes_get(&origins, word_offset + 3)) * 16777216;
        word_offset = (semantic_node - 1) * 20 + 8;
        semantic_line = result_value(bytes_get(&origins, word_offset))
            + result_value(bytes_get(&origins, word_offset + 1)) * 256
            + result_value(bytes_get(&origins, word_offset + 2)) * 65536
            + result_value(bytes_get(&origins, word_offset + 3)) * 16777216;
        word_offset = (semantic_node - 1) * 20 + 12;
        semantic_column = result_value(bytes_get(&origins, word_offset))
            + result_value(bytes_get(&origins, word_offset + 1)) * 256
            + result_value(bytes_get(&origins, word_offset + 2)) * 65536
            + result_value(bytes_get(&origins, word_offset + 3)) * 16777216;
    }

    // Match the accepted semantic phase order: all identifier uses first.
    let mut semantic_index: int = 0;
    let mut semantic_kind: int = 0;
    let mut semantic_payload: int = 0;
    let mut semantic_left: int = 0;
    let mut semantic_right: int = 0;
    while status == 0 && semantic_status == 0 && semantic_index < node_count {
        word_offset = semantic_index * 16;
        byte_0 = result_value(bytes_get(&nodes, word_offset));
        byte_1 = result_value(bytes_get(&nodes, word_offset + 1));
        byte_2 = result_value(bytes_get(&nodes, word_offset + 2));
        byte_3 = result_value(bytes_get(&nodes, word_offset + 3));
        if byte_0 < 0 || byte_1 < 0 || byte_2 < 0 || byte_3 < 0 || byte_3 > 127 {
            semantic_status = 27;
            semantic_node = semantic_index + 1;
            semantic_code = 2;
        } else {
            semantic_kind = byte_0 + byte_1 * 256 + byte_2 * 65536
                + byte_3 * 16777216;
        }
        if semantic_status == 0 && semantic_kind == 2 {
            word_offset = semantic_index * 20 + 4;
            byte_0 = result_value(bytes_get(&origins, word_offset));
            byte_1 = result_value(bytes_get(&origins, word_offset + 1));
            byte_2 = result_value(bytes_get(&origins, word_offset + 2));
            byte_3 = result_value(bytes_get(&origins, word_offset + 3));
            semantic_status = 17;
            semantic_node = semantic_index + 1;
            semantic_offset = byte_0 + byte_1 * 256 + byte_2 * 65536
                + byte_3 * 16777216;
            word_offset = semantic_index * 20 + 8;
            semantic_line = result_value(bytes_get(&origins, word_offset))
                + result_value(bytes_get(&origins, word_offset + 1)) * 256
                + result_value(bytes_get(&origins, word_offset + 2)) * 65536
                + result_value(bytes_get(&origins, word_offset + 3)) * 16777216;
            word_offset = semantic_index * 20 + 12;
            semantic_column = result_value(bytes_get(&origins, word_offset))
                + result_value(bytes_get(&origins, word_offset + 1)) * 256
                + result_value(bytes_get(&origins, word_offset + 2)) * 65536
                + result_value(bytes_get(&origins, word_offset + 3)) * 16777216;
            semantic_code = 2;
        }
        semantic_index = semantic_index + 1;
    }

    // Classify one postorder D1 node per iteration and append one fact.
    semantic_index = 0;
    let mut semantic_left_type: int = 0;
    let mut semantic_right_type: int = 0;
    let mut semantic_complete_type: int = 0;
    let mut semantic_ownership: int = 0;
    let mut semantic_rule_found: int = 0;
    let mut semantic_item_index: int = 0;
    let mut semantic_previous_function: int = 0;
    let mut symbol_name_word: int = 0;
    let mut symbol_function_word: int = 0;
    while status == 0 && semantic_status == 0 && semantic_index < node_count {
        semantic_node = semantic_index + 1;
        origin_offset = semantic_index * 20 + 4;
        semantic_offset = result_value(bytes_get(&origins, origin_offset))
            + result_value(bytes_get(&origins, origin_offset + 1)) * 256
            + result_value(bytes_get(&origins, origin_offset + 2)) * 65536
            + result_value(bytes_get(&origins, origin_offset + 3)) * 16777216;
        origin_offset = semantic_index * 20 + 8;
