                    semantic_append_word = 1;
                    if semantic_append_field == 1 {
                        semantic_append_word = function_payload;
                    } else if semantic_append_field == 2 {
                        semantic_append_word = semantic_item_node;
                    } else if semantic_append_field == 3 {
                        semantic_append_word = 1;
