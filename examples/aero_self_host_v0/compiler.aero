fn result_value(result: Result<int, int>) -> int {
    return match result {
        Ok(value) => value,
        Err(code) => 0 - code,
    };
}

fn is_identifier_start(value: int) -> int {
    if value == 95 || (value >= 65 && value <= 90) || (value >= 97 && value <= 122) {
        return 1;
    }
    return 0;
}

fn is_identifier_continue(value: int) -> int {
    if is_identifier_start(value) == 1 || (value >= 48 && value <= 57) {
        return 1;
    }
    return 0;
}

fn is_digit(value: int) -> int {
    if value >= 48 && value <= 57 {
        return 1;
    }
    return 0;
}

fn keyword_token_kind(length: int, b0: int, b1: int, b2: int,
        b3: int, b4: int, b5: int) -> int {
    if length == 2 {
        if b0 == 102 && b1 == 110 {
            return 3;
        }
        if b0 == 105 && b1 == 102 {
            return 7;
        }
    } else if length == 3 {
        if b0 == 108 && b1 == 101 && b2 == 116 {
            return 4;
        }
        if b0 == 109 && b1 == 117 && b2 == 116 {
            return 5;
        }
    } else if length == 4 {
        if b0 == 101 && b1 == 108 && b2 == 115 && b3 == 101 {
            return 8;
        }
    } else if length == 5 {
        if b0 == 119 && b1 == 104 && b2 == 105 && b3 == 108 && b4 == 101 {
            return 9;
        }
    } else if length == 6 {
        if b0 == 114 && b1 == 101 && b2 == 116 && b3 == 117
            && b4 == 114 && b5 == 110 {
            return 6;
        }
    }
    return 1;
}

fn pair_token_kind(first: int, second: int) -> int {
    if first == 61 && second == 61 {
        return 26;
    }
    if first == 33 && second == 61 {
        return 28;
    }
    if first == 60 && second == 61 {
        return 30;
    }
    if first == 62 && second == 61 {
        return 32;
    }
    if first == 38 && second == 38 {
        return 33;
    }
    if first == 124 && second == 124 {
        return 34;
    }
    if first == 45 && second == 62 {
        return 35;
    }
    if first == 61 && second == 62 {
        return 36;
    }
    return 0;
}

fn single_token_kind(value: int) -> int {
    if value == 40 {
        return 10;
    }
    if value == 41 {
        return 11;
    }
    if value == 123 {
        return 12;
    }
    if value == 125 {
        return 13;
    }
    if value == 91 {
        return 14;
    }
    if value == 93 {
        return 15;
    }
    if value == 44 {
        return 16;
    }
    if value == 58 {
        return 17;
    }
    if value == 59 {
        return 18;
    }
    if value == 46 {
        return 19;
    }
    if value == 43 {
        return 20;
    }
    if value == 45 {
        return 21;
    }
    if value == 42 {
        return 22;
    }
    if value == 47 {
        return 23;
    }
    if value == 37 {
        return 24;
    }
    if value == 61 {
        return 25;
    }
    if value == 33 {
        return 27;
    }
    if value == 60 {
        return 29;
    }
    if value == 62 {
        return 31;
    }
    if value == 38 {
        return 37;
    }
    return 0;
}

fn quotient_256(value: int) -> int {
    let mut remaining: int = value;
    let mut quotient: int = 0;
    while remaining >= 256 {
        remaining = remaining - 256;
        quotient = quotient + 1;
    }
    return quotient;
}

fn signed_quotient(dividend: int, divisor: int) -> int {
    let minimum: int = (0 - 2147483647) - 1;
    if divisor == 0 || (dividend == minimum && divisor == 0 - 1) {
        return 0;
    }
    let mut negative: int = 0;
    if (dividend < 0 && divisor > 0) || (dividend > 0 && divisor < 0) {
        negative = 1;
    }
    let mut negative_dividend: int = dividend;
    if negative_dividend > 0 {
        negative_dividend = 0 - negative_dividend;
    }
    let mut negative_divisor: int = divisor;
    if negative_divisor > 0 {
        negative_divisor = 0 - negative_divisor;
    }
    let mut quotient: int = 0;
    let mut remainder: int = negative_dividend;
    while remainder <= negative_divisor {
        let mut value: int = negative_divisor;
        let mut power: int = 0 - 1;
        while value >= 0 - 1073741824 && remainder <= value + value {
            value = value + value;
            power = power + power;
        }
        remainder = remainder - value;
        quotient = quotient + power;
    }
    if negative == 1 {
        return quotient;
    }
    return 0 - quotient;
}

fn word_byte_0(value: int) -> int {
    let mut remaining: int = value;
    while remaining >= 256 {
        remaining = remaining - 256;
    }
    return remaining;
}

fn word_byte_1(value: int) -> int {
    return word_byte_0(quotient_256(value));
}

fn word_byte_2(value: int) -> int {
    return word_byte_0(quotient_256(quotient_256(value)));
}

fn word_byte_3(value: int) -> int {
    return quotient_256(quotient_256(quotient_256(value)));
}

fn checksum_step(checksum: int, word: int) -> int {
    let mut reduced_word: int = word;
    while reduced_word >= 1000003 {
        reduced_word = reduced_word - 1000003;
    }
    let mut combined: int = checksum * 31 + reduced_word;
    while combined >= 1000003 {
        combined = combined - 1000003;
    }
    return combined;
}

fn read_input_value() -> int {
    let read: Result<int, int> = stdin_read_byte();
    return result_value(read);
}

fn binary_precedence(kind: int) -> int {
    if kind == 34 {
        return 1;
    }
    if kind == 33 {
        return 2;
    }
    if kind == 26 || kind == 28 {
        return 3;
    }
    if kind == 29 || kind == 30 || kind == 31 || kind == 32 {
        return 4;
    }
    if kind == 20 || kind == 21 {
        return 5;
    }
    if kind == 22 || kind == 23 || kind == 24 {
        return 6;
    }
    return 0;
}

fn binary_node_kind(kind: int) -> int {
    if kind == 22 {
        return 5;
    }
    if kind == 23 {
        return 6;
    }
    if kind == 24 {
        return 7;
    }
    if kind == 20 {
        return 8;
    }
    if kind == 21 {
        return 9;
    }
    if kind == 29 {
        return 10;
    }
    if kind == 30 {
        return 11;
    }
    if kind == 31 {
        return 12;
    }
    if kind == 32 {
        return 13;
    }
    if kind == 26 {
        return 14;
    }
    if kind == 28 {
        return 15;
    }
    if kind == 33 {
        return 16;
    }
    if kind == 34 {
        return 17;
    }
    return 0;
}

fn unsigned_decimal_length(value: int) -> int {
    if value >= 1000000000 {
        return 10;
    }
    if value >= 100000000 {
        return 9;
    }
    if value >= 10000000 {
        return 8;
    }
    if value >= 1000000 {
        return 7;
    }
    if value >= 100000 {
        return 6;
    }
    if value >= 10000 {
        return 5;
    }
    if value >= 1000 {
        return 4;
    }
    if value >= 100 {
        return 3;
    }
    if value >= 10 {
        return 2;
    }
    return 1;
}

fn unsigned_decimal_digit(value: int, index: int, length: int) -> int {
    let mut divisor: int = 1;
    let mut remaining: int = length - index - 1;
    while remaining > 0 {
        divisor = divisor * 10;
        remaining = remaining - 1;
    }
    let quotient: int = signed_quotient(value, divisor);
    let tens: int = signed_quotient(quotient, 10);
    return 48 + quotient - tens * 10;
}

fn emitter_fixed_length(fragment: int) -> int {
    let mut prologue_length: int = 37;
    if fragment == 13 {
        prologue_length = 21;
    }
    if fragment == 1 || fragment == 13 {
        return prologue_length;
    }
    if fragment == 2 {
        return 4;
    }
    if fragment == 3 || fragment == 4 || fragment == 5 {
        return 11;
    }
    if fragment == 6 || fragment == 14 {
        return 12;
    }
    if fragment == 7 {
        return 14;
    }
    if fragment == 8 || fragment == 9 || fragment == 12 {
        return 2;
    }
    if fragment == 10 {
        return 10;
    }
    if fragment == 11 {
        return 1;
    }
    return 0;
}

fn emitter_fixed_byte(raw_fragment: int, raw_index: int) -> int {
    let mut fragment: int = raw_fragment;
    let mut index: int = raw_index;
    if fragment == 13 {
        fragment = 1;
        if index == 20 {
            index = 2;
        }
    } else if fragment == 14 {
        fragment = 1;
        index = index + 25;
    }
    if fragment == 1 {
        if index == 0 { return 100; }
        if index == 1 { return 101; }
        if index == 2 { return 102; }
        if index == 3 { return 105; }
        if index == 4 { return 110; }
        if index == 5 { return 101; }
        if index == 6 { return 32; }
        if index == 7 { return 105; }
        if index == 8 { return 51; }
        if index == 9 { return 50; }
        if index == 10 { return 32; }
        if index == 11 { return 64; }
        if index == 12 { return 97; }
        if index == 13 { return 101; }
        if index == 14 { return 114; }
        if index == 15 { return 111; }
        if index == 16 { return 95; }
        if index == 17 { return 98; }
        if index == 18 { return 49; }
        if index == 19 { return 95; }
        if index == 20 { return 101; }
        if index == 21 { return 110; }
        if index == 22 { return 116; }
        if index == 23 { return 114; }
        if index == 24 { return 121; }
        if index == 25 { return 40; }
        if index == 26 { return 41; }
        if index == 27 { return 32; }
        if index == 28 { return 123; }
        if index == 29 { return 10; }
        if index == 30 { return 101; }
        if index == 31 { return 110; }
        if index == 32 { return 116; }
        if index == 33 { return 114; }
        if index == 34 { return 121; }
        if index == 35 { return 58; }
        if index == 36 { return 10; }
    }
    if fragment == 2 {
        if index == 0 || index == 1 { return 32; }
        if index == 2 { return 37; }
        if index == 3 { return 114; }
    }
    if fragment >= 3 && fragment <= 7 {
        if index == 0 || index == 2 { return 32; }
        if index == 1 { return 61; }
        if index == 3 {
            if fragment == 3 { return 97; }
            if fragment == 4 || fragment == 6 || fragment == 7 { return 115; }
            return 109;
        }
        if index == 4 {
            if fragment == 3 { return 100; }
            if fragment == 4 || fragment == 5 || fragment == 7 { return 117; }
            return 100;
        }
        if index == 5 {
            if fragment == 3 { return 100; }
            if fragment == 4 || fragment == 7 { return 98; }
            if fragment == 5 { return 108; }
            return 105;
        }
        if fragment == 6 {
            if index == 6 { return 118; }
            if index == 7 { return 32; }
            if index == 8 { return 105; }
            if index == 9 { return 51; }
            if index == 10 { return 50; }
            if index == 11 { return 32; }
        } else {
            if index == 6 { return 32; }
            if index == 7 { return 105; }
            if index == 8 { return 51; }
            if index == 9 { return 50; }
            if index == 10 { return 32; }
            if fragment == 7 {
                if index == 11 { return 48; }
                if index == 12 { return 44; }
                if index == 13 { return 32; }
            }
        }
    }
    if fragment == 8 {
        if index == 0 { return 37; }
        if index == 1 { return 114; }
    }
    if fragment == 9 {
        if index == 0 { return 44; }
        if index == 1 { return 32; }
    }
    if fragment == 10 {
        if index == 0 || index == 1 || index == 5 || index == 9 { return 32; }
        if index == 2 { return 114; }
        if index == 3 { return 101; }
        if index == 4 { return 116; }
        if index == 6 { return 105; }
        if index == 7 { return 51; }
        if index == 8 { return 50; }
    }
    if fragment == 11 {
        return 10;
    }
    if fragment == 12 {
        if index == 0 { return 125; }
        if index == 1 { return 10; }
    }
    return 0;
}

fn run_runtime_ascii_llvm_emitter(expected_status: int, expected_offset: int,
        expected_line: int, expected_column: int, expected_code: int,
        expected_actual: int, expected_names: int, expected_tokens: int,
        expected_nodes: int, expected_root: int, expected_checksum: int,
        expected_semantic_status: int, expected_semantic_node: int,
        expected_semantic_offset: int, expected_semantic_line: int,
        expected_semantic_column: int, expected_semantic_code: int,
        expected_semantic_expected: int, expected_semantic_actual: int,
        expected_origins: int, expected_symbols: int, expected_facts: int,
        expected_semantic_root: int, expected_semantic_checksum: int,
        expected_checked_attempted: int, expected_checked_status: int,
        expected_checked_node: int, expected_checked_offset: int,
        expected_checked_line: int, expected_checked_column: int,
        expected_checked_code: int, expected_checked_expected: int,
        expected_checked_actual: int, expected_checked_values: int,
        expected_checked_instructions: int, expected_checked_results: int,
        expected_checked_words: int, expected_checked_root_kind: int,
        expected_checked_root_payload: int, expected_checked_root_type: int,
        expected_checked_checksum: int, verification_fault_word: int,
        verification_fault_value: int, expected_verified_attempted: int,
        expected_verified_status: int, expected_verified_word_index: int,
        expected_verified_record_id: int, expected_verified_code: int,
        expected_verified_expected: int, expected_verified_actual: int,
        expected_verified_instructions: int, expected_verified_results: int,
        expected_verified_root_value: int, expected_verified_result_values: int,
        expected_verified_checksum: int, expected_emitted_attempted: int,
        expected_emitted_status: int, expected_emitted_byte_index: int,
        expected_emitted_record_id: int, expected_emitted_length: int,
        expected_emitted_checksum: int, expected_driven_attempted: int,
        expected_driven_status: int, expected_driven_runtime_code: int,
        expected_driven_byte_index: int, expected_driven_length: int,
        expected_driven_checksum: int, expected_parameters: int) -> int {
    let mut source: ByteBuffer = bytes_new();
    let mut names: ByteBuffer = bytes_new();
    let mut tokens: ByteBuffer = bytes_new();
    let mut nodes: ByteBuffer = bytes_new();
    let mut parameters: ByteBuffer = bytes_new();
    let mut blocks: ByteBuffer = bytes_new();
    let mut calls: ByteBuffer = bytes_new();
    let mut values: ByteBuffer = bytes_new();
    let mut operators: ByteBuffer = bytes_new();
    let mut origins: ByteBuffer = bytes_new();
    let mut symbols: ByteBuffer = bytes_new();
    let mut facts: ByteBuffer = bytes_new();
    let mut checked_values: ByteBuffer = bytes_new();
    let mut checked_instructions: ByteBuffer = bytes_new();
    let mut checked_ir: ByteBuffer = bytes_new();
    let mut verified_results: ByteBuffer = bytes_new();
    let mut emitted_llvm: ByteBuffer = bytes_new();

    if expected_status < 0 || expected_offset < -1 || expected_line < 0
        || expected_column < 0 || expected_code < 0 || expected_actual < 0
        || expected_names < 0 || expected_tokens < 0 || expected_nodes < 0
        || expected_root < 0 || expected_checksum < 0 {
        return 40;
    }
    if expected_semantic_status < 0 || expected_semantic_node < 0
        || expected_semantic_offset < -1 || expected_semantic_line < 0
        || expected_semantic_column < 0 || expected_semantic_code < 0
        || expected_semantic_expected < 0 || expected_semantic_actual < 0
        || expected_origins < 0 || expected_symbols < 0 || expected_facts < 0
        || expected_semantic_root < 0 || expected_semantic_checksum < 0 {
        return 40;
    }
    if expected_checked_attempted < 0 || expected_checked_status < 0
        || expected_checked_node < 0 || expected_checked_offset < -1
        || expected_checked_line < 0 || expected_checked_column < 0
        || expected_checked_code < 0 || expected_checked_expected < 0
        || expected_checked_actual < 0 || expected_checked_values < 0
        || expected_checked_instructions < 0 || expected_checked_results < 0 {
        return 40;
    }
    if expected_checked_words < 0 || expected_checked_root_kind < 0
        || expected_checked_root_payload < 0 || expected_checked_root_type < 0
        || expected_checked_checksum < 0 || verification_fault_word < -1
        || verification_fault_value < 0 || expected_verified_attempted < 0
        || expected_verified_status < 0 || expected_verified_word_index < -1 {
        return 40;
    }
    if expected_verified_record_id < 0 || expected_verified_code < 0
        || expected_verified_expected < 0 || expected_verified_actual < 0
        || expected_verified_instructions < 0 || expected_verified_results < 0
        || expected_verified_result_values < 0 || expected_verified_checksum < 0 {
        return 40;
    }
    if expected_emitted_attempted < 0 || expected_emitted_status < 0
        || expected_emitted_byte_index < -1 || expected_emitted_record_id < 0
        || expected_emitted_length < 0 || expected_emitted_checksum < 0 {
        return 40;
    }
    if expected_driven_attempted < 0 || expected_driven_status < 0
        || expected_driven_runtime_code < 0
        || expected_driven_byte_index < -1 || expected_driven_length < 0
        || expected_driven_checksum < 0 || expected_parameters < 0 {
        return 40;
    }

    let mut status: int = 0;
    let mut error_offset: int = -1;
    let mut error_line: int = 0;
    let mut error_column: int = 0;
    let mut diagnostic_code: int = 0;
    let mut diagnostic_actual: int = 0;
    let mut semantic_status: int = 0;
    let mut semantic_node: int = 0;
    let mut semantic_offset: int = -1;
    let mut semantic_line: int = 0;
    let mut semantic_column: int = 0;
    let mut semantic_code: int = 0;
    let mut semantic_expected: int = 0;
    let mut semantic_actual: int = 0;
    let mut input_line: int = 1;
    let mut input_column: int = 1;
    let mut reading: int = 1;
    let mut input_value: int = 0;
    let mut push_result: int = 0;
    while reading == 1 {
        input_value = read_input_value();
        if input_value >= 0 {
            if bytes_len(&source) >= 1048576 {
                status = 2;
                error_offset = 1048576;
                error_line = input_line;
                error_column = input_column;
                reading = 0;
            } else {
                push_result = result_value(bytes_push(&mut source, input_value));
                if push_result < 0 {
                    status = 8;
                    error_offset = bytes_len(&source);
                    error_line = input_line;
                    error_column = input_column;
                    reading = 0;
                } else if input_value == 10 {
                    input_line = input_line + 1;
                    input_column = 1;
                } else {
                    input_column = input_column + 1;
                }
            }
        } else if input_value == -1 {
            reading = 0;
        } else {
            status = 1;
            error_offset = bytes_len(&source);
            error_line = input_line;
            error_column = input_column;
            reading = 0;
        }
    }

    let source_length: int = bytes_len(&source);
    let mut name_count: int = 0;
    let mut token_count: int = 0;
    let mut offset: int = 0;
    let mut line: int = 1;
    let mut column: int = 1;
    let mut lexing: int = 0;
    let mut lex_complete: int = 0;
    if status == 0 {
        lexing = 1;
    }

    let mut byte: int = 0;
    let mut next_byte: int = 0;
    let mut token_start: int = 0;
    let mut token_end: int = 0;
    let mut token_length: int = 0;
    let mut token_line: int = 0;
    let mut token_column: int = 0;
    let mut kind: int = 0;
    let mut name_id: int = 0;
    let mut pair_kind: int = 0;
    let mut single_kind: int = 0;
    let mut comment_open: int = 0;
    let mut comment_line: int = 0;
    let mut comment_column: int = 0;
    let mut comment_closed: int = 0;
    let mut b0: int = 0;
    let mut b1: int = 0;
    let mut b2: int = 0;
    let mut b3: int = 0;
    let mut b4: int = 0;
    let mut b5: int = 0;
    let mut found_name_id: int = 0;
    let mut candidate_name: int = 0;
    let mut stored_start: int = 0;
    let mut stored_length: int = 0;
    let mut name_field: int = 0;
    let mut word_offset: int = 0;
    let mut byte_0: int = 0;
    let mut byte_1: int = 0;
    let mut byte_2: int = 0;
    let mut byte_3: int = 0;
    let mut word: int = 0;
    let mut same: int = 0;
    let mut compare_index: int = 0;
    let mut canonical_byte: int = 0;
    let mut current_byte: int = 0;
    let mut append_failed: int = 0;
    let mut append_field: int = 0;
    let mut scanning_token: int = 0;

    while offset < source_length && lexing == 1 {
        byte = result_value(bytes_get(&source, offset));
        if byte < 0 {
            status = 9;
            lexing = 0;
        } else if byte > 127 {
            status = 3;
            error_offset = offset;
            error_line = line;
            error_column = column;
            lexing = 0;
        } else if byte == 32 || byte == 9 || byte == 13 || byte == 10 {
            if byte == 10 {
                line = line + 1;
                column = 1;
            } else {
                column = column + 1;
            }
            offset = offset + 1;
        } else {
            next_byte = -1;
            if offset + 1 < source_length {
                next_byte = result_value(bytes_get(&source, offset + 1));
                if next_byte < 0 {
                    status = 9;
                    lexing = 0;
                }
            }

            if lexing == 1 && byte == 47 && next_byte == 47 {
                offset = offset + 2;
                column = column + 2;
                while offset < source_length && lexing == 1 {
                    byte = result_value(bytes_get(&source, offset));
                    if byte < 0 {
                        status = 9;
                        lexing = 0;
                    } else if byte > 127 {
                        status = 3;
                        error_offset = offset;
                        error_line = line;
                        error_column = column;
                        lexing = 0;
                    } else if byte == 13 || byte == 10 {
                        lexing = 2;
                    } else {
                        offset = offset + 1;
                        column = column + 1;
                    }
                }
                if lexing == 2 {
                    lexing = 1;
                }
            } else if lexing == 1 && byte == 47 && next_byte == 42 {
                comment_open = offset;
                comment_line = line;
                comment_column = column;
                comment_closed = 0;
                offset = offset + 2;
                column = column + 2;
                while offset < source_length && comment_closed == 0 && lexing == 1 {
                    byte = result_value(bytes_get(&source, offset));
                    if byte < 0 {
                        status = 9;
                        lexing = 0;
                    } else if byte > 127 {
                        status = 3;
                        error_offset = offset;
                        error_line = line;
                        error_column = column;
                        lexing = 0;
                    } else {
                        next_byte = -1;
                        if offset + 1 < source_length {
                            next_byte = result_value(bytes_get(&source, offset + 1));
                            if next_byte < 0 {
                                status = 9;
                                lexing = 0;
                            }
                        }
                        if lexing == 1 && byte == 42 && next_byte == 47 {
                            offset = offset + 2;
                            column = column + 2;
                            comment_closed = 1;
                        } else if lexing == 1 {
                            if byte == 10 {
                                line = line + 1;
                                column = 1;
                            } else {
                                column = column + 1;
                            }
                            offset = offset + 1;
                        }
                    }
                }
                if lexing == 1 && comment_closed == 0 {
                    status = 4;
                    error_offset = comment_open;
                    error_line = comment_line;
                    error_column = comment_column;
                    lexing = 0;
                }
            } else if lexing == 1 {
                token_start = offset;
                token_line = line;
                token_column = column;
                token_end = offset + 1;
                kind = 0;
                name_id = 0;

                if is_identifier_start(byte) == 1 {
                    scanning_token = 1;
                    while token_end < source_length && scanning_token == 1 {
                        next_byte = result_value(bytes_get(&source, token_end));
                        if next_byte < 0 {
                            status = 9;
                            lexing = 0;
                            scanning_token = 0;
                        } else if is_identifier_continue(next_byte) == 1 {
                            token_end = token_end + 1;
                        } else {
                            scanning_token = 0;
                        }
                    }
                    token_length = token_end - token_start;
                    if lexing == 1 && token_length > 63 {
                        status = 5;
                        error_offset = token_start;
                        error_line = token_line;
                        error_column = token_column;
                        lexing = 0;
                    }

                    if lexing == 1 {
                        b0 = byte;
                        b1 = 0;
                        b2 = 0;
                        b3 = 0;
                        b4 = 0;
                        b5 = 0;
                        if token_length > 1 {
                            b1 = result_value(bytes_get(&source, token_start + 1));
                        }
                        if token_length > 2 {
                            b2 = result_value(bytes_get(&source, token_start + 2));
                        }
                        if token_length > 3 {
                            b3 = result_value(bytes_get(&source, token_start + 3));
                        }
                        if token_length > 4 {
                            b4 = result_value(bytes_get(&source, token_start + 4));
                        }
                        if token_length > 5 {
                            b5 = result_value(bytes_get(&source, token_start + 5));
                        }
                        if b0 < 0 || b1 < 0 || b2 < 0 || b3 < 0 || b4 < 0 || b5 < 0 {
                            status = 9;
                            lexing = 0;
                        } else {
                            kind = keyword_token_kind(token_length, b0, b1, b2, b3, b4, b5);
                        }
                    }

                    if lexing == 1 && kind == 1 {
                        found_name_id = 0;
                        candidate_name = 0;
                        while candidate_name < name_count && found_name_id == 0
                            && lexing == 1 {
                            stored_start = 0;
                            stored_length = 0;
                            name_field = 0;
                            while name_field < 2 && lexing == 1 {
                                word_offset = candidate_name * 8 + name_field * 4;
                                byte_0 = result_value(bytes_get(&names, word_offset));
                                byte_1 = result_value(bytes_get(&names, word_offset + 1));
                                byte_2 = result_value(bytes_get(&names, word_offset + 2));
                                byte_3 = result_value(bytes_get(&names, word_offset + 3));
                                if byte_0 < 0 || byte_1 < 0 || byte_2 < 0 || byte_3 < 0
                                    || byte_3 > 127 {
                                    status = 9;
                                    lexing = 0;
                                } else {
                                    word = byte_0 + byte_1 * 256 + byte_2 * 65536
                                        + byte_3 * 16777216;
                                    if name_field == 0 {
                                        stored_start = word;
                                    } else {
                                        stored_length = word;
                                    }
                                    name_field = name_field + 1;
                                }
                            }
                            if lexing == 1 && stored_length == token_length {
                                same = 1;
                                compare_index = 0;
                                while compare_index < token_length && same == 1 {
                                    canonical_byte = result_value(bytes_get(
                                        &source, stored_start + compare_index));
                                    current_byte = result_value(bytes_get(
                                        &source, token_start + compare_index));
                                    if canonical_byte < 0 || current_byte < 0 {
                                        status = 9;
                                        lexing = 0;
                                        same = 0;
                                    } else if canonical_byte != current_byte {
                                        same = 0;
                                    }
                                    compare_index = compare_index + 1;
                                }
