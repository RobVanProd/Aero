                byte_0 = result_value(bytes_get(&nodes, word_offset));
                byte_1 = result_value(bytes_get(&nodes, word_offset + 1));
                byte_2 = result_value(bytes_get(&nodes, word_offset + 2));
                byte_3 = result_value(bytes_get(&nodes, word_offset + 3));
