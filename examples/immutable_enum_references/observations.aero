fn read_mode(value: &Mode) -> int {
    match *value { Mode::Off => 0, Mode::On => 2 }
}

fn read_signal(value: &Signal) -> int {
    match *value { Signal::Empty => 0, Signal::Count(inner) => inner }
}

fn read_packet(value: &Packet) -> int {
    match *value {
        Packet::Empty => 0,
        Packet::Pair(number, ready) => number
    }
}

fn read_packet_twice(first: &Packet, second: &Packet) -> int {
    read_packet(first) + read_packet(second)
}
