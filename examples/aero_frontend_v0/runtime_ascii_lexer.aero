fn result_value(result: Result<int, int>) -> int {
    return match result {
        Ok(value) => value,
        Err(code) => 0 - code,
    };
}

fn is_identifier_start(value: int) -> int {
    if value == 95 || (value >= 65 && value <= 90) || (value >= 97 && value <= 122) {
        return 1;
    }
    return 0;
}

fn is_identifier_continue(value: int) -> int {
    if is_identifier_start(value) == 1 || (value >= 48 && value <= 57) {
        return 1;
    }
    return 0;
}

fn is_digit(value: int) -> int {
    if value >= 48 && value <= 57 {
        return 1;
    }
    return 0;
}

fn keyword_token_kind(length: int, b0: int, b1: int, b2: int,
        b3: int, b4: int, b5: int) -> int {
    if length == 2 {
        if b0 == 102 && b1 == 110 {
            return 3;
        }
        if b0 == 105 && b1 == 102 {
            return 7;
        }
    } else if length == 3 {
        if b0 == 108 && b1 == 101 && b2 == 116 {
            return 4;
        }
        if b0 == 109 && b1 == 117 && b2 == 116 {
            return 5;
        }
    } else if length == 4 {
        if b0 == 101 && b1 == 108 && b2 == 115 && b3 == 101 {
            return 8;
        }
    } else if length == 5 {
        if b0 == 119 && b1 == 104 && b2 == 105 && b3 == 108 && b4 == 101 {
            return 9;
        }
    } else if length == 6 {
        if b0 == 114 && b1 == 101 && b2 == 116 && b3 == 117
            && b4 == 114 && b5 == 110 {
            return 6;
        }
    }
    return 1;
}

fn pair_token_kind(first: int, second: int) -> int {
    if first == 61 && second == 61 {
        return 26;
    }
    if first == 33 && second == 61 {
        return 28;
    }
    if first == 60 && second == 61 {
        return 30;
    }
    if first == 62 && second == 61 {
        return 32;
    }
    if first == 38 && second == 38 {
        return 33;
    }
    if first == 124 && second == 124 {
        return 34;
    }
    if first == 45 && second == 62 {
        return 35;
    }
    if first == 61 && second == 62 {
        return 36;
    }
    return 0;
}

fn single_token_kind(value: int) -> int {
    if value == 40 {
        return 10;
    }
    if value == 41 {
        return 11;
    }
    if value == 123 {
        return 12;
    }
    if value == 125 {
        return 13;
    }
    if value == 91 {
        return 14;
    }
    if value == 93 {
        return 15;
    }
    if value == 44 {
        return 16;
    }
    if value == 58 {
        return 17;
    }
    if value == 59 {
        return 18;
    }
    if value == 46 {
        return 19;
    }
    if value == 43 {
        return 20;
    }
    if value == 45 {
        return 21;
    }
    if value == 42 {
        return 22;
    }
    if value == 47 {
        return 23;
    }
    if value == 37 {
        return 24;
    }
    if value == 61 {
        return 25;
    }
    if value == 33 {
        return 27;
    }
    if value == 60 {
        return 29;
    }
    if value == 62 {
        return 31;
    }
    return 0;
}

fn quotient_256(value: int) -> int {
    let mut remaining: int = value;
    let mut quotient: int = 0;
    while remaining >= 256 {
        remaining = remaining - 256;
        quotient = quotient + 1;
    }
    return quotient;
}

fn word_byte_0(value: int) -> int {
    let mut remaining: int = value;
    while remaining >= 256 {
        remaining = remaining - 256;
    }
    return remaining;
}

fn word_byte_1(value: int) -> int {
    return word_byte_0(quotient_256(value));
}

fn word_byte_2(value: int) -> int {
    return word_byte_0(quotient_256(quotient_256(value)));
}

fn word_byte_3(value: int) -> int {
    return quotient_256(quotient_256(quotient_256(value)));
}

fn checksum_step(checksum: int, word: int) -> int {
    let mut reduced_word: int = word;
    while reduced_word >= 1000003 {
        reduced_word = reduced_word - 1000003;
    }
    let mut combined: int = checksum * 31 + reduced_word;
    while combined >= 1000003 {
        combined = combined - 1000003;
    }
    return combined;
}

fn read_input_value() -> int {
    let read: Result<int, int> = stdin_read_byte();
    return result_value(read);
}

fn run_runtime_ascii_lexer(expected_status: int, expected_offset: int,
        expected_line: int, expected_column: int, expected_names: int,
        expected_tokens: int, expected_checksum: int) -> int {
    let mut source: ByteBuffer = bytes_new();
    let mut names: ByteBuffer = bytes_new();
    let mut tokens: ByteBuffer = bytes_new();

    if expected_status < 0 || expected_offset < -1 || expected_line < 0
        || expected_column < 0 || expected_names < 0 || expected_tokens < 0
        || expected_checksum < 0 {
        return 10;
    }

    let mut status: int = 0;
    let mut error_offset: int = -1;
    let mut error_line: int = 0;
    let mut error_column: int = 0;
    let mut input_line: int = 1;
    let mut input_column: int = 1;
    let mut reading: int = 1;
    let mut input_value: int = 0;
    let mut push_result: int = 0;
    while reading == 1 {
        input_value = read_input_value();
        if input_value >= 0 {
            if bytes_len(&source) >= 8192 {
                status = 2;
                error_offset = 8192;
                error_line = input_line;
                error_column = input_column;
                reading = 0;
            } else {
                push_result = result_value(bytes_push(&mut source, input_value));
                if push_result < 0 {
                    status = 8;
                    error_offset = bytes_len(&source);
                    error_line = input_line;
                    error_column = input_column;
                    reading = 0;
                } else if input_value == 10 {
                    input_line = input_line + 1;
                    input_column = 1;
                } else {
                    input_column = input_column + 1;
                }
            }
        } else if input_value == -1 {
            reading = 0;
        } else {
            status = 1;
            error_offset = bytes_len(&source);
            error_line = input_line;
            error_column = input_column;
            reading = 0;
        }
    }

    let source_length: int = bytes_len(&source);
    let mut name_count: int = 0;
    let mut token_count: int = 0;
    let mut offset: int = 0;
    let mut line: int = 1;
    let mut column: int = 1;
    let mut lexing: int = 0;
    if status == 0 {
        lexing = 1;
    }

    let mut byte: int = 0;
    let mut next_byte: int = 0;
    let mut token_start: int = 0;
    let mut token_end: int = 0;
    let mut token_length: int = 0;
    let mut token_line: int = 0;
    let mut token_column: int = 0;
    let mut kind: int = 0;
    let mut name_id: int = 0;
    let mut pair_kind: int = 0;
    let mut single_kind: int = 0;
    let mut comment_open: int = 0;
    let mut comment_line: int = 0;
    let mut comment_column: int = 0;
    let mut comment_closed: int = 0;
    let mut b0: int = 0;
    let mut b1: int = 0;
    let mut b2: int = 0;
    let mut b3: int = 0;
    let mut b4: int = 0;
    let mut b5: int = 0;
    let mut found_name_id: int = 0;
    let mut candidate_name: int = 0;
    let mut stored_start: int = 0;
    let mut stored_length: int = 0;
    let mut name_field: int = 0;
    let mut word_offset: int = 0;
    let mut byte_0: int = 0;
    let mut byte_1: int = 0;
    let mut byte_2: int = 0;
    let mut byte_3: int = 0;
    let mut word: int = 0;
    let mut same: int = 0;
    let mut compare_index: int = 0;
    let mut canonical_byte: int = 0;
    let mut current_byte: int = 0;
    let mut append_failed: int = 0;
    let mut append_field: int = 0;
    let mut scanning_token: int = 0;

    while offset < source_length && lexing == 1 {
        byte = result_value(bytes_get(&source, offset));
        if byte < 0 {
            status = 9;
            lexing = 0;
        } else if byte > 127 {
            status = 3;
            error_offset = offset;
            error_line = line;
            error_column = column;
            lexing = 0;
        } else if byte == 32 || byte == 9 || byte == 13 || byte == 10 {
            if byte == 10 {
                line = line + 1;
                column = 1;
            } else {
                column = column + 1;
            }
            offset = offset + 1;
        } else {
            next_byte = -1;
            if offset + 1 < source_length {
                next_byte = result_value(bytes_get(&source, offset + 1));
                if next_byte < 0 {
                    status = 9;
                    lexing = 0;
                }
            }

            if lexing == 1 && byte == 47 && next_byte == 47 {
                offset = offset + 2;
                column = column + 2;
                while offset < source_length && lexing == 1 {
                    byte = result_value(bytes_get(&source, offset));
                    if byte < 0 {
                        status = 9;
                        lexing = 0;
                    } else if byte > 127 {
                        status = 3;
                        error_offset = offset;
                        error_line = line;
                        error_column = column;
                        lexing = 0;
                    } else if byte == 13 || byte == 10 {
                        lexing = 2;
                    } else {
                        offset = offset + 1;
                        column = column + 1;
                    }
                }
                if lexing == 2 {
                    lexing = 1;
                }
            } else if lexing == 1 && byte == 47 && next_byte == 42 {
                comment_open = offset;
                comment_line = line;
                comment_column = column;
                comment_closed = 0;
                offset = offset + 2;
                column = column + 2;
                while offset < source_length && comment_closed == 0 && lexing == 1 {
                    byte = result_value(bytes_get(&source, offset));
                    if byte < 0 {
                        status = 9;
                        lexing = 0;
                    } else if byte > 127 {
                        status = 3;
                        error_offset = offset;
                        error_line = line;
                        error_column = column;
                        lexing = 0;
                    } else {
                        next_byte = -1;
                        if offset + 1 < source_length {
                            next_byte = result_value(bytes_get(&source, offset + 1));
                            if next_byte < 0 {
                                status = 9;
                                lexing = 0;
                            }
                        }
                        if lexing == 1 && byte == 42 && next_byte == 47 {
                            offset = offset + 2;
                            column = column + 2;
                            comment_closed = 1;
                        } else if lexing == 1 {
                            if byte == 10 {
                                line = line + 1;
                                column = 1;
                            } else {
                                column = column + 1;
                            }
                            offset = offset + 1;
                        }
                    }
                }
                if lexing == 1 && comment_closed == 0 {
                    status = 4;
                    error_offset = comment_open;
                    error_line = comment_line;
                    error_column = comment_column;
                    lexing = 0;
                }
            } else if lexing == 1 {
                token_start = offset;
                token_line = line;
                token_column = column;
                token_end = offset + 1;
                kind = 0;
                name_id = 0;

                if is_identifier_start(byte) == 1 {
                    scanning_token = 1;
                    while token_end < source_length && scanning_token == 1 {
                        next_byte = result_value(bytes_get(&source, token_end));
                        if next_byte < 0 {
                            status = 9;
                            lexing = 0;
                            scanning_token = 0;
                        } else if is_identifier_continue(next_byte) == 1 {
                            token_end = token_end + 1;
                        } else {
                            scanning_token = 0;
                        }
                    }
                    token_length = token_end - token_start;
                    if lexing == 1 && token_length > 63 {
                        status = 5;
                        error_offset = token_start;
                        error_line = token_line;
                        error_column = token_column;
                        lexing = 0;
                    }

                    if lexing == 1 {
                        b0 = byte;
                        b1 = 0;
                        b2 = 0;
                        b3 = 0;
                        b4 = 0;
                        b5 = 0;
                        if token_length > 1 {
                            b1 = result_value(bytes_get(&source, token_start + 1));
                        }
                        if token_length > 2 {
                            b2 = result_value(bytes_get(&source, token_start + 2));
                        }
                        if token_length > 3 {
                            b3 = result_value(bytes_get(&source, token_start + 3));
                        }
                        if token_length > 4 {
                            b4 = result_value(bytes_get(&source, token_start + 4));
                        }
                        if token_length > 5 {
                            b5 = result_value(bytes_get(&source, token_start + 5));
                        }
                        if b0 < 0 || b1 < 0 || b2 < 0 || b3 < 0 || b4 < 0 || b5 < 0 {
                            status = 9;
                            lexing = 0;
                        } else {
                            kind = keyword_token_kind(token_length, b0, b1, b2, b3, b4, b5);
                        }
                    }

                    if lexing == 1 && kind == 1 {
                        found_name_id = 0;
                        candidate_name = 0;
                        while candidate_name < name_count && found_name_id == 0
                            && lexing == 1 {
                            stored_start = 0;
                            stored_length = 0;
                            name_field = 0;
                            while name_field < 2 && lexing == 1 {
                                word_offset = candidate_name * 8 + name_field * 4;
                                byte_0 = result_value(bytes_get(&names, word_offset));
                                byte_1 = result_value(bytes_get(&names, word_offset + 1));
                                byte_2 = result_value(bytes_get(&names, word_offset + 2));
                                byte_3 = result_value(bytes_get(&names, word_offset + 3));
                                if byte_0 < 0 || byte_1 < 0 || byte_2 < 0 || byte_3 < 0
                                    || byte_3 > 127 {
                                    status = 9;
                                    lexing = 0;
                                } else {
                                    word = byte_0 + byte_1 * 256 + byte_2 * 65536
                                        + byte_3 * 16777216;
                                    if name_field == 0 {
                                        stored_start = word;
                                    } else {
                                        stored_length = word;
                                    }
                                    name_field = name_field + 1;
                                }
                            }
                            if lexing == 1 && stored_length == token_length {
                                same = 1;
                                compare_index = 0;
                                while compare_index < token_length && same == 1 {
                                    canonical_byte = result_value(bytes_get(
                                        &source, stored_start + compare_index));
                                    current_byte = result_value(bytes_get(
                                        &source, token_start + compare_index));
                                    if canonical_byte < 0 || current_byte < 0 {
                                        status = 9;
                                        lexing = 0;
                                        same = 0;
                                    } else if canonical_byte != current_byte {
                                        same = 0;
                                    }
                                    compare_index = compare_index + 1;
                                }
                                if lexing == 1 && same == 1 {
                                    found_name_id = candidate_name + 1;
                                }
                            }
                            candidate_name = candidate_name + 1;
                        }

                        if lexing == 1 && found_name_id == 0 && name_count >= 1024 {
                            status = 7;
                            error_offset = token_start;
                            error_line = token_line;
                            error_column = token_column;
                            lexing = 0;
                        }
                        if lexing == 1 && token_count >= 1024 {
                            status = 6;
                            error_offset = token_start;
                            error_line = token_line;
                            error_column = token_column;
                            lexing = 0;
                        }

                        if lexing == 1 && found_name_id == 0 {
                            append_failed = 0;
                            append_field = 0;
                            while append_field < 2 && append_failed == 0 {
                                word = token_start;
                                if append_field == 1 {
                                    word = token_length;
                                }
                                push_result = result_value(bytes_push(&mut names, word_byte_0(word)));
                                if push_result < 0 {
                                    append_failed = 1;
                                }
                                if append_failed == 0 {
                                    push_result = result_value(bytes_push(&mut names, word_byte_1(word)));
                                    if push_result < 0 {
                                        append_failed = 1;
                                    }
                                }
                                if append_failed == 0 {
                                    push_result = result_value(bytes_push(&mut names, word_byte_2(word)));
                                    if push_result < 0 {
                                        append_failed = 1;
                                    }
                                }
                                if append_failed == 0 {
                                    push_result = result_value(bytes_push(&mut names, word_byte_3(word)));
                                    if push_result < 0 {
                                        append_failed = 1;
                                    }
                                }
                                append_field = append_field + 1;
                            }
                            if append_failed == 1 {
                                status = 8;
                                error_offset = token_start;
                                error_line = token_line;
                                error_column = token_column;
                                lexing = 0;
                            } else {
                                name_count = name_count + 1;
                                found_name_id = name_count;
                            }
                        }
                        name_id = found_name_id;
                    } else if lexing == 1 && token_count >= 1024 {
                        status = 6;
                        error_offset = token_start;
                        error_line = token_line;
                        error_column = token_column;
                        lexing = 0;
                    }
                } else if is_digit(byte) == 1 {
                    scanning_token = 1;
                    while token_end < source_length && scanning_token == 1 {
                        next_byte = result_value(bytes_get(&source, token_end));
                        if next_byte < 0 {
                            status = 9;
                            lexing = 0;
                            scanning_token = 0;
                        } else if is_digit(next_byte) == 1 {
                            token_end = token_end + 1;
                        } else {
                            scanning_token = 0;
                        }
                    }
                    kind = 2;
                    if lexing == 1 && token_count >= 1024 {
                        status = 6;
                        error_offset = token_start;
                        error_line = token_line;
                        error_column = token_column;
                        lexing = 0;
                    }
                } else {
                    pair_kind = 0;
                    if next_byte >= 0 {
                        pair_kind = pair_token_kind(byte, next_byte);
                    }
                    if pair_kind > 0 {
                        kind = pair_kind;
                        token_end = token_start + 2;
                    } else {
                        single_kind = single_token_kind(byte);
                        if single_kind > 0 {
                            kind = single_kind;
                            token_end = token_start + 1;
                        } else {
                            status = 4;
                            error_offset = token_start;
                            error_line = token_line;
                            error_column = token_column;
                            lexing = 0;
                        }
                    }
                    if lexing == 1 && token_count >= 1024 {
                        status = 6;
                        error_offset = token_start;
                        error_line = token_line;
                        error_column = token_column;
                        lexing = 0;
                    }
                }

                if lexing == 1 {
                    token_length = token_end - token_start;
                    append_failed = 0;
                    append_field = 0;
                    while append_field < 6 && append_failed == 0 {
                        word = kind;
                        if append_field == 1 {
                            word = token_start;
                        } else if append_field == 2 {
                            word = token_length;
                        } else if append_field == 3 {
                            word = token_line;
                        } else if append_field == 4 {
                            word = token_column;
                        } else if append_field == 5 {
                            word = name_id;
                        }
                        push_result = result_value(bytes_push(&mut tokens, word_byte_0(word)));
                        if push_result < 0 {
                            append_failed = 1;
                        }
                        if append_failed == 0 {
                            push_result = result_value(bytes_push(&mut tokens, word_byte_1(word)));
                            if push_result < 0 {
                                append_failed = 1;
                            }
                        }
                        if append_failed == 0 {
                            push_result = result_value(bytes_push(&mut tokens, word_byte_2(word)));
                            if push_result < 0 {
                                append_failed = 1;
                            }
                        }
                        if append_failed == 0 {
                            push_result = result_value(bytes_push(&mut tokens, word_byte_3(word)));
                            if push_result < 0 {
                                append_failed = 1;
                            }
                        }
                        append_field = append_field + 1;
                    }
                    if append_failed == 1 {
                        status = 8;
                        error_offset = token_start;
                        error_line = token_line;
                        error_column = token_column;
                        lexing = 0;
                    } else {
                        token_count = token_count + 1;
                        offset = token_end;
                        column = column + token_length;
                    }
                }
            }
        }
    }

    if status == 0 {
        kind = 0;
        token_start = source_length;
        token_length = 0;
        token_line = line;
        token_column = column;
        name_id = 0;
        append_failed = 0;
        append_field = 0;
        while append_field < 6 && append_failed == 0 {
            word = kind;
            if append_field == 1 {
                word = token_start;
            } else if append_field == 2 {
                word = token_length;
            } else if append_field == 3 {
                word = token_line;
            } else if append_field == 4 {
                word = token_column;
            } else if append_field == 5 {
                word = name_id;
            }
            push_result = result_value(bytes_push(&mut tokens, word_byte_0(word)));
            if push_result < 0 {
                append_failed = 1;
            }
            if append_failed == 0 {
                push_result = result_value(bytes_push(&mut tokens, word_byte_1(word)));
                if push_result < 0 {
                    append_failed = 1;
                }
            }
            if append_failed == 0 {
                push_result = result_value(bytes_push(&mut tokens, word_byte_2(word)));
                if push_result < 0 {
                    append_failed = 1;
                }
            }
            if append_failed == 0 {
                push_result = result_value(bytes_push(&mut tokens, word_byte_3(word)));
                if push_result < 0 {
                    append_failed = 1;
                }
            }
            append_field = append_field + 1;
        }
        if append_failed == 1 {
            status = 8;
            error_offset = source_length;
            error_line = line;
            error_column = column;
        } else {
            token_count = token_count + 1;
        }
    }

    if bytes_len(&names) < name_count * 8 || bytes_len(&tokens) < token_count * 24 {
        return 70;
    }
    if status == 0
        && (bytes_len(&names) != name_count * 8 || bytes_len(&tokens) != token_count * 24) {
        return 70;
    }

    let mut checksum: int = 17;
    let mut validate_source: int = 0;
    while validate_source < source_length {
        byte = result_value(bytes_get(&source, validate_source));
        if byte < 0 || byte > 255 {
            return 71;
        }
        checksum = checksum_step(checksum, byte);
        validate_source = validate_source + 1;
    }
    checksum = checksum_step(checksum, 990);

    let mut validate_name: int = 0;
    let mut validate_name_start: int = 0;
    let mut validate_name_length: int = 0;
    while validate_name < name_count {
        name_field = 0;
        while name_field < 2 {
            word_offset = validate_name * 8 + name_field * 4;
            byte_0 = result_value(bytes_get(&names, word_offset));
            byte_1 = result_value(bytes_get(&names, word_offset + 1));
            byte_2 = result_value(bytes_get(&names, word_offset + 2));
            byte_3 = result_value(bytes_get(&names, word_offset + 3));
            if byte_0 < 0 || byte_1 < 0 || byte_2 < 0 || byte_3 < 0 || byte_3 > 127 {
                return 72;
            }
            word = byte_0 + byte_1 * 256 + byte_2 * 65536 + byte_3 * 16777216;
            checksum = checksum_step(checksum, word);
            if name_field == 0 {
                validate_name_start = word;
            } else {
                validate_name_length = word;
            }
            name_field = name_field + 1;
        }
        if validate_name_length <= 0 || validate_name_length > 63
            || validate_name_start < 0 || validate_name_start > source_length
            || validate_name_length > source_length - validate_name_start {
            return 73;
        }
        compare_index = 0;
        while compare_index < validate_name_length {
            byte = result_value(bytes_get(&source, validate_name_start + compare_index));
            if byte < 0 || (compare_index == 0 && is_identifier_start(byte) == 0)
                || (compare_index > 0 && is_identifier_continue(byte) == 0) {
                return 73;
            }
            compare_index = compare_index + 1;
        }
        validate_name = validate_name + 1;
    }
    checksum = checksum_step(checksum, 991);

    let mut validate_token: int = 0;
    let mut validate_kind: int = 0;
    let mut validate_start: int = 0;
    let mut validate_length: int = 0;
    let mut validate_line: int = 0;
    let mut validate_column: int = 0;
    let mut validate_name_id: int = 0;
    let mut validate_field: int = 0;
    let mut previous_end: int = 0;
    let mut location_index: int = 0;
    let mut location_line: int = 1;
    let mut location_column: int = 1;
    while validate_token < token_count {
        validate_field = 0;
        while validate_field < 6 {
            word_offset = validate_token * 24 + validate_field * 4;
            byte_0 = result_value(bytes_get(&tokens, word_offset));
            byte_1 = result_value(bytes_get(&tokens, word_offset + 1));
            byte_2 = result_value(bytes_get(&tokens, word_offset + 2));
            byte_3 = result_value(bytes_get(&tokens, word_offset + 3));
            if byte_0 < 0 || byte_1 < 0 || byte_2 < 0 || byte_3 < 0 || byte_3 > 127 {
                return 74;
            }
            word = byte_0 + byte_1 * 256 + byte_2 * 65536 + byte_3 * 16777216;
            checksum = checksum_step(checksum, word);
            if validate_field == 0 {
                validate_kind = word;
            } else if validate_field == 1 {
                validate_start = word;
            } else if validate_field == 2 {
                validate_length = word;
            } else if validate_field == 3 {
                validate_line = word;
            } else if validate_field == 4 {
                validate_column = word;
            } else {
                validate_name_id = word;
            }
            validate_field = validate_field + 1;
        }
        if validate_kind < 0 || validate_kind > 36 || validate_start < previous_end
            || validate_start > source_length || validate_length < 0
            || validate_length > source_length - validate_start
            || validate_line <= 0 || validate_column <= 0 {
            return 75;
        }
        location_index = 0;
        location_line = 1;
        location_column = 1;
        while location_index < validate_start {
            byte = result_value(bytes_get(&source, location_index));
            if byte < 0 {
                return 75;
            }
            if byte == 10 {
                location_line = location_line + 1;
                location_column = 1;
            } else {
                location_column = location_column + 1;
            }
            location_index = location_index + 1;
        }
        if location_line != validate_line || location_column != validate_column {
            return 75;
        }
        if validate_kind == 0 {
            if status != 0 || validate_token != token_count - 1
                || validate_start != source_length || validate_length != 0
                || validate_name_id != 0 {
                return 76;
            }
        } else {
            if validate_length <= 0 {
                return 76;
            }
            if validate_kind == 1 {
                if validate_name_id <= 0 || validate_name_id > name_count {
                    return 76;
                }
            } else if validate_name_id != 0 {
                return 76;
            }
        }
        previous_end = validate_start + validate_length;
        validate_token = validate_token + 1;
    }
    checksum = checksum_step(checksum, 992);

    checksum = checksum_step(checksum, status);
    checksum = checksum_step(checksum, error_offset + 1);
    checksum = checksum_step(checksum, error_line);
    checksum = checksum_step(checksum, error_column);
    checksum = checksum_step(checksum, name_count);
    checksum = checksum_step(checksum, token_count);

    if status != expected_status || error_offset != expected_offset
        || error_line != expected_line || error_column != expected_column
        || name_count != expected_names || token_count != expected_tokens
        || checksum != expected_checksum {
        return 80;
    }
    return 91;
}

