                        error_offset = token_start;
                        error_line = token_line;
                        error_column = token_column;
                        lexing = 0;
                    }
                }

                if lexing == 1 {
                    token_length = token_end - token_start;
                    append_failed = 0;
                    append_field = 0;
                    while append_field < 6 && append_failed == 0 {
                        word = kind;
                        if append_field == 1 {
                            word = token_start;
                        } else if append_field == 2 {
                            word = token_length;
                        } else if append_field == 3 {
                            word = token_line;
                        } else if append_field == 4 {
                            word = token_column;
                        } else if append_field == 5 {
                            word = name_id;
                        }
                        push_result = result_value(bytes_push(&mut tokens, word_byte_0(word)));
                        if push_result < 0 {
                            append_failed = 1;
                        }
                        if append_failed == 0 {
                            push_result = result_value(bytes_push(&mut tokens, word_byte_1(word)));
                            if push_result < 0 {
                                append_failed = 1;
                            }
