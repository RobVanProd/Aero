                        verified_word_index = 27 + verified_instruction_index * 11;
                        verified_record_id = verified_expected_instruction_id;
                        verified_code = 1;
                        verified_expected = 3;
                        verified_actual = verified_result_values;
                    }
                    verified_scratch_byte = verified_scratch_byte + 1;
                }
                verified_scratch_field = verified_scratch_field + 1;
            }
            if verified_status == 0 {
                verified_result_values = verified_result_values + 1;
            }
        }
        if verified_status == 0 {
            verified_previous_origin = verified_origin;
        }
        verified_instruction_index = verified_instruction_index + 1;
    }

    let mut verified_result_index: int = 0;
    let mut verified_result_field: int = 0;
    let mut verified_result_kind: int = 0;
    let mut verified_result_function: int = 0;
    let mut verified_result_id: int = 0;
    let mut verified_result_type: int = 0;
    let mut verified_definition_id: int = 0;
    let mut verified_result_origin: int = 0;
    let mut verified_expected_origin: int = 0;
    while verified_attempted == 1 && verified_status == 0
        && verified_result_index < verified_result_count {
        verified_result_kind = 0;
        verified_result_function = 0;
        verified_result_id = 0;
        verified_result_type = 0;
        verified_definition_id = 0;
        verified_result_origin = 0;
        verified_result_field = 0;
        while verified_result_field < 6 {
            verified_scan_index = 25 + verified_instruction_count * 11
                + verified_result_index * 6 + verified_result_field;
            word_offset = verified_scan_index * 4;
            verified_byte_0 = result_value(bytes_get(&checked_ir, word_offset));
            verified_byte_1 = result_value(bytes_get(&checked_ir, word_offset + 1));
            verified_byte_2 = result_value(bytes_get(&checked_ir, word_offset + 2));
            verified_byte_3 = result_value(bytes_get(&checked_ir, word_offset + 3));
            verified_word = verified_byte_0 + verified_byte_1 * 256
                + verified_byte_2 * 65536 + verified_byte_3 * 16777216;
            if verification_fault_word == verified_scan_index {
                verified_word = verification_fault_value;
            }
            if verified_result_field == 0 {
                verified_result_kind = verified_word;
            } else if verified_result_field == 1 {
                verified_result_function = verified_word;
            } else if verified_result_field == 2 {
                verified_result_id = verified_word;
            } else if verified_result_field == 3 {
                verified_result_type = verified_word;
            } else if verified_result_field == 4 {
                verified_definition_id = verified_word;
            } else if verified_result_field == 5 {
                verified_result_origin = verified_word;
            }
            verified_result_field = verified_result_field + 1;
        }
        let verified_expected_result_id: int = verified_result_index + 1;
        if verified_result_kind != 4 {
            verified_status = 6;
            verified_word_index = 25 + verified_instruction_count * 11
                + verified_result_index * 6;
            verified_record_id = verified_expected_result_id;
            verified_code = 1;
            verified_expected = 4;
            verified_actual = verified_result_kind;
        } else if verified_result_function != 1 {
            verified_status = 6;
            verified_word_index = 26 + verified_instruction_count * 11
                + verified_result_index * 6;
            verified_record_id = verified_expected_result_id;
            verified_code = 1;
            verified_expected = 1;
            verified_actual = verified_result_function;
        } else if verified_result_id != verified_expected_result_id {
            verified_status = 6;
            verified_word_index = 27 + verified_instruction_count * 11
                + verified_result_index * 6;
            verified_record_id = verified_expected_result_id;
            verified_code = 1;
            verified_expected = verified_expected_result_id;
            verified_actual = verified_result_id;
        } else if verified_result_type != 1 {
            verified_status = 6;
            verified_word_index = 28 + verified_instruction_count * 11
                + verified_result_index * 6;
            verified_record_id = verified_expected_result_id;
            verified_code = 1;
            verified_expected = 1;
            verified_actual = verified_result_type;
        } else if verified_definition_id != verified_expected_result_id {
            verified_status = 6;
            verified_word_index = 29 + verified_instruction_count * 11
                + verified_result_index * 6;
            verified_record_id = verified_expected_result_id;
            verified_code = 2;
            verified_expected = verified_expected_result_id;
            verified_actual = verified_definition_id;
        }
        if verified_status == 0 {
            verified_scan_index = 34 + verified_result_index * 11;
            word_offset = verified_scan_index * 4;
            verified_byte_0 = result_value(bytes_get(&checked_ir, word_offset));
            verified_byte_1 = result_value(bytes_get(&checked_ir, word_offset + 1));
            verified_byte_2 = result_value(bytes_get(&checked_ir, word_offset + 2));
            verified_byte_3 = result_value(bytes_get(&checked_ir, word_offset + 3));
            verified_expected_origin = verified_byte_0 + verified_byte_1 * 256
                + verified_byte_2 * 65536 + verified_byte_3 * 16777216;
            if verification_fault_word == verified_scan_index {
                verified_expected_origin = verification_fault_value;
            }
            if verified_result_origin != verified_expected_origin {
                verified_status = 6;
                verified_word_index = 30 + verified_instruction_count * 11
                    + verified_result_index * 6;
                verified_record_id = verified_expected_result_id;
                verified_code = 3;
                verified_expected = verified_expected_origin;
                verified_actual = verified_result_origin;
            }
        }
        verified_result_index = verified_result_index + 1;
    }

    if verified_attempted == 1 && verified_status == 0
        && verified_header_root_kind != verified_return_kind {
        verified_status = 7;
        verified_word_index = 6;
        verified_record_id = verified_instruction_count;
        verified_code = 2;
        verified_expected = verified_return_kind;
        verified_actual = verified_header_root_kind;
    }
    if verified_attempted == 1 && verified_status == 0
        && verified_header_root_payload != verified_return_payload {
        verified_status = 7;
        verified_word_index = 7;
        verified_record_id = verified_instruction_count;
        verified_code = 2;
        verified_expected = verified_return_payload;
        verified_actual = verified_header_root_payload;
    }
    if verified_attempted == 1 && verified_status == 0 {
        verified_root_value = 0;
        if verified_header_root_kind == 1 {
            verified_root_value = verified_header_root_payload;
        } else if verified_header_root_kind == 2
            && verified_header_root_payload > 0
            && verified_header_root_payload <= verified_result_values {
            verified_scratch_offset = (verified_header_root_payload - 1) * 12;
            verified_scratch_sign = result_value(bytes_get(
                &verified_results, verified_scratch_offset))
                + result_value(bytes_get(&verified_results,
                    verified_scratch_offset + 1)) * 256
                + result_value(bytes_get(&verified_results,
                    verified_scratch_offset + 2)) * 65536
                + result_value(bytes_get(&verified_results,
                    verified_scratch_offset + 3)) * 16777216;
            verified_scratch_high = result_value(bytes_get(
                &verified_results, verified_scratch_offset + 4))
                + result_value(bytes_get(&verified_results,
                    verified_scratch_offset + 5)) * 256
                + result_value(bytes_get(&verified_results,
                    verified_scratch_offset + 6)) * 65536
                + result_value(bytes_get(&verified_results,
                    verified_scratch_offset + 7)) * 16777216;
            verified_scratch_low = result_value(bytes_get(
                &verified_results, verified_scratch_offset + 8))
                + result_value(bytes_get(&verified_results,
                    verified_scratch_offset + 9)) * 256
                + result_value(bytes_get(&verified_results,
                    verified_scratch_offset + 10)) * 65536
                + result_value(bytes_get(&verified_results,
                    verified_scratch_offset + 11)) * 16777216;
            if verified_scratch_sign == 1 && verified_scratch_high == 65536
                && verified_scratch_low == 0 {
                verified_root_value = verified_minimum;
            } else {
                verified_scratch_magnitude = verified_scratch_high * 32768
                    + verified_scratch_low;
                verified_root_value = verified_scratch_magnitude;
                if verified_scratch_sign == 1 {
                    verified_root_value = 0 - verified_scratch_magnitude;
                }
            }
        } else {
            verified_status = 7;
            verified_word_index = 6;
            verified_record_id = verified_instruction_count;
            verified_code = 2;
            verified_expected = verified_return_kind;
            verified_actual = verified_header_root_kind;
        }
    }
    if verified_attempted == 1 && verified_status == 0
        && verified_root_value != verified_return_value {
        verified_status = 7;
        verified_word_index = 7;
        verified_record_id = verified_instruction_count;
        verified_code = 3;
        verified_expected = verified_return_value;
        verified_actual = verified_root_value;
    }

    if verified_status == 0 {
        if verified_root_value == verified_minimum {
            verified_root_sign = 1;
            verified_root_high = 65536;
            verified_root_low = 0;
        } else {
            verified_scratch_magnitude = verified_root_value;
            if verified_root_value < 0 {
                verified_root_sign = 1;
                verified_scratch_magnitude = 0 - verified_root_value;
            }
            verified_root_high = signed_quotient(verified_scratch_magnitude, 32768);
            verified_root_low = verified_scratch_magnitude
                - verified_root_high * 32768;
        }
    } else {
        verified_root_value = 0;
        verified_root_sign = 0;
        verified_root_high = 0;
        verified_root_low = 0;
    }

    verified_checksum = checksum_step(verified_checksum, 995);
    verified_checksum = checksum_step(verified_checksum, verified_status);
    verified_word = 0;
    if verified_word_index >= 0 {
        verified_word = verified_word_index + 1;
    }
    verified_checksum = checksum_step(verified_checksum, verified_word);
    verified_checksum = checksum_step(verified_checksum, verified_record_id);
    verified_checksum = checksum_step(verified_checksum, verified_code);
    verified_checksum = checksum_step(verified_checksum, verified_expected);
    verified_checksum = checksum_step(verified_checksum, verified_actual);
    verified_checksum = checksum_step(verified_checksum, verified_attempted);
    verified_checksum = checksum_step(verified_checksum, verified_instruction_count);
    verified_checksum = checksum_step(verified_checksum, verified_result_count);
    verified_checksum = checksum_step(verified_checksum, verified_root_sign);
    verified_checksum = checksum_step(verified_checksum, verified_root_high);
    verified_checksum = checksum_step(verified_checksum, verified_root_low);
    verified_checksum = checksum_step(verified_checksum, verified_result_values);
    // CAP-045 B1A VERIFIER END

    if checked_attempted != expected_checked_attempted
        || checked_status != expected_checked_status
        || checked_node != expected_checked_node
        || checked_offset != expected_checked_offset
        || checked_line != expected_checked_line
        || checked_column != expected_checked_column
        || checked_code != expected_checked_code
        || checked_expected != expected_checked_expected
        || checked_actual != expected_checked_actual
        || checked_value_count != expected_checked_values
        || checked_instruction_count != expected_checked_instructions
        || checked_result_count != expected_checked_results
        || checked_word_count != expected_checked_words
        || checked_root_kind != expected_checked_root_kind
        || checked_root_payload != expected_checked_root_payload
        || checked_root_type != expected_checked_root_type
        || checked_checksum != expected_checked_checksum {
        return 92;
    }
    if verified_attempted != expected_verified_attempted
        || verified_status != expected_verified_status
        || verified_word_index != expected_verified_word_index
        || verified_record_id != expected_verified_record_id
        || verified_code != expected_verified_code
        || verified_expected != expected_verified_expected
        || verified_actual != expected_verified_actual
        || verified_instruction_count != expected_verified_instructions
        || verified_result_count != expected_verified_results
        || verified_root_value != expected_verified_root_value
        || verified_result_values != expected_verified_result_values
        || verified_checksum != expected_verified_checksum {
        return 93;
    }
    return 91;
}

// CAP-045 TRACKED SELF-TEST

fn main() -> int {
    return run_runtime_ascii_checked_ir_verifier(0, -1, 0, 0, 0, 0,
        2, 20, 11, 11, 586661,
        0, 0, -1, 0, 0, 0, 0, 0,
        11, 1, 11, 1, 827574,
        1, 0, 0, -1, 0, 0, 0, 0, 0,
        9, 5, 4, 104, 2, 4, 1, 355067,
        -1, 0,
        1, 0, -1, 0, 0, 0, 0,
        5, 4, 5, 4, 592819);
}
