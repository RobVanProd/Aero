fn raise(value: &mut int) -> int {
    let mut index = 0;
    while index < 3 {
        *value = *value + index;
        index = index + 1;
    }
    if *value > 0 { *value = *value + 9; } else { *value = 0; }
    *value
}

fn adjust_ratio(value: &mut float) -> float {
    *value = *value + 0.5;
    *value
}

fn set_ready(value: &mut bool) {
    *value = 1 == 1;
}
